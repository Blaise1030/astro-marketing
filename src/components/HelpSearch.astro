---
// Pagefind search. The index is generated by `npm run build`, so it is absent in `npm run dev`.
// Site CSS styles the markup; we skip pagefind-ui.css so the bar matches Help.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<div id="help-search" data-base={base} class="help-search mx-auto w-full max-w-xl text-left">
  <p data-search-fallback class="rounded-xl border border-hairline bg-raised px-4 py-3 text-sm text-muted-ink">Loading search…</p>
</div>
<script>
  const root = document.getElementById("help-search");
  if (root) {
    const base = root.dataset.base ?? "/";
    const script = document.createElement("script");
    script.src = `${base}pagefind/pagefind-ui.js`;
    script.onload = () => {
      root.querySelector("[data-search-fallback]")?.remove();
      // @ts-expect-error PagefindUI is defined by the script above.
      new PagefindUI({
        element: "#help-search",
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        baseUrl: base,
        translations: { placeholder: "Search help" },
      });
    };
    script.onerror = () => {
      root.innerHTML = '<p class="rounded-xl border border-hairline bg-raised px-4 py-3 text-sm text-muted-ink">Search is available in the built site. Run <code class="font-mono text-[0.8125rem]">npm run build</code> to create the index.</p>';
    };
    document.head.append(script);
  }
</script>
