---
// Pagefind search. The index is generated by `npm run build`, so it is absent in `npm run dev`.
// Site CSS styles the markup; we skip pagefind-ui.css so the bar matches Help.
// A same-sized shell paints first so loading Pagefind does not shift the page.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<div data-base={base} class="help-search mx-auto w-full max-w-xl text-left">
  <div data-search-fallback class="help-search__shell" aria-hidden="true">
    <span class="help-search__shell-icon"></span>
    <span class="help-search__shell-placeholder">Search help</span>
  </div>
  <div id="help-search"></div>
</div>
<script>
  const wrap = document.querySelector(".help-search[data-base]");
  const root = document.getElementById("help-search");
  if (wrap && root) {
    const base = wrap.dataset.base ?? "/";
    const fallback = wrap.querySelector("[data-search-fallback]");
    const script = document.createElement("script");
    script.src = `${base}pagefind/pagefind-ui.js`;
    script.onload = () => {
      // @ts-expect-error PagefindUI is defined by the script above.
      new PagefindUI({
        element: "#help-search",
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        autofocus: false,
        baseUrl: base,
        translations: { placeholder: "Search help" },
      });
      // Reveal the live field only after it exists — shell already reserved the space.
      fallback?.remove();
    };
    script.onerror = () => {
      fallback?.remove();
      root.innerHTML = '<p class="rounded-xl border border-hairline bg-raised px-4 py-3 text-sm text-muted-ink">Search will be available once the site is published.</p>';
    };
    document.head.append(script);
  }
</script>
