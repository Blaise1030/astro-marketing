---
// Pagefind search. The index is generated by `npm run build`, so it is absent in `npm run dev`.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<div id="help-search" data-base={base} class="help-search mx-auto w-full max-w-xl text-left">
  <noscript><p class="text-sm text-brand-muted">Search needs JavaScript.</p></noscript>
</div>
<script>
  const root = document.getElementById("help-search");
  if (root) {
    const base = root.dataset.base ?? "/";
    const css = document.createElement("link");
    css.rel = "stylesheet";
    css.href = `${base}pagefind/pagefind-ui.css`;
    document.head.append(css);
    const script = document.createElement("script");
    script.src = `${base}pagefind/pagefind-ui.js`;
    script.onload = () => {
      // @ts-expect-error PagefindUI is defined by the script above.
      new PagefindUI({ element: "#help-search", showSubResults: true, showImages: false, baseUrl: base, translations: { placeholder: "Search help" } });
    };
    script.onerror = () => {
      root.innerHTML = '<p class="rounded-lg border border-section-line bg-section-panel px-4 py-3 text-sm text-brand-muted">Search is available in the built site. Run <code>npm run build</code> to create the index.</p>';
    };
    document.head.append(script);
  }
</script>
