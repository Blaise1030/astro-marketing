---
import { href } from "../lib/href";
import type { Doc } from "../lib/help";
const { doc } = Astro.props as { doc: Doc };
---
<article class="group border-t border-section-line pt-5">
  <a class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent" href={href(`/help/${doc.id}/`)}>
    <p class="text-xs font-medium uppercase tracking-wide text-brand-muted">{doc.data.section}</p>
    <h2 class="mt-4 text-xl font-medium tracking-tight text-balance transition-colors group-hover:text-brand-accent">{doc.data.title}</h2>
    <p class="mt-3 leading-relaxed text-brand-muted">{doc.data.description}</p>
  </a>
</article>
