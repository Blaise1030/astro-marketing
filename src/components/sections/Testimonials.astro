---
const testimonials = [
  { quote: "We went from idea to live site in an afternoon.", author: "Jordan Lee", role: "Founder, Northwind" },
  { quote: "Editing copy has never been this painless.", author: "Sam Rivera", role: "Marketing Lead, Globex" },
];
---

<section class="mx-auto max-w-5xl px-8 py-lg" id="testimonials">
  <h2 class="mb-md text-h2 tracking-tight">What customers say</h2>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-md">
    {testimonials.map((t) => (
      <figure>
        <blockquote class="rounded-lg bg-note p-5 text-body-sm dark:bg-note/15">{t.quote}</blockquote>
        <figcaption class="mt-3 text-caption text-secondary dark:text-neutral-400">
          <span class="text-label text-primary dark:text-neutral-100">{t.author}</span>, {t.role}
        </figcaption>
      </figure>
    ))}
  </div>
</section>
