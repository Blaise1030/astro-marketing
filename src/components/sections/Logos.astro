---
const { data, id, Content } = Astro.props;
---

<section class="mx-auto max-w-5xl px-8 py-lg text-center" id={id}>
  {data.heading && <h2 class="mb-md text-h2 tracking-tight">{data.heading}</h2>}
  <div class="prose mx-auto mb-md dark:prose-invert prose-a:text-accent"><Content /></div>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-md text-label text-secondary dark:text-neutral-400">
    {data.items.map((l) => (
      <div>{l.url ? <a class="hover:text-accent" href={l.url}>{l.name}</a> : l.name}</div>
    ))}
  </div>
</section>
