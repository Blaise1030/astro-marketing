---
const logos = ["Northwind", "Globex", "Initech", "Umbrella"];
---

<section class="mx-auto max-w-5xl px-8 py-lg text-center" id="logos">
  <h2 class="mb-md text-h2 tracking-tight">Loved by teams at</h2>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-md text-label text-secondary dark:text-neutral-400">
    {logos.map((name) => <div>{name}</div>)}
  </div>
</section>
