---
const logos = [
  {
    name: "Northwind",
    mark: `<path d="M16 3 27 29l-11-6-11 6Z" fill="currentColor"/>`,
  },
  {
    name: "Globex",
    mark: `<circle cx="16" cy="16" r="12" fill="none" stroke="currentColor" stroke-width="2.5"/><ellipse cx="16" cy="16" rx="5" ry="12" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M4 16h24" stroke="currentColor" stroke-width="2.5"/>`,
  },
  {
    name: "Initech",
    mark: `<rect x="4" y="4" width="24" height="24" rx="5" fill="currentColor"/><circle cx="16" cy="10.5" r="2.25" class="fill-white dark:fill-neutral-950"/><rect x="14" y="15" width="4" height="9" rx="1" class="fill-white dark:fill-neutral-950"/>`,
  },
  {
    name: "Umbrella",
    mark: `<path d="M3 16a13 13 0 0 1 26 0Z" fill="currentColor"/><path d="M16 16v9a3 3 0 0 1-6 0" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>`,
  },
];
---

<section class="mx-auto max-w-5xl px-8 py-16 text-center" id="logos">
  <h2 class="mb-6 text-3xl font-bold tracking-tight">Loved by teams at</h2>
  <ul class="grid grid-cols-2 gap-6 text-neutral-600 sm:grid-cols-4 dark:text-neutral-400">
    {
      logos.map(({ name, mark }) => (
        <li class="flex items-center justify-center gap-2">
          <svg class="size-7 shrink-0" viewBox="0 0 32 32" aria-hidden="true" set:html={mark} />
          <span class="text-xl font-bold tracking-tight">{name}</span>
        </li>
      ))
    }
  </ul>
</section>
