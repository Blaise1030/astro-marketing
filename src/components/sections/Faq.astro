---
import { FaqList } from "@/components/faq-list";
import { faqs } from "@/lib/faqs";
import { href } from "@/lib/href";
---

<section class="px-6 py-16 sm:px-10 sm:py-24" id="faq">
  <div class="grid gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <span class="rounded-sm bg-brand/10 px-1.5 py-0.5 text-[0.7rem] font-medium text-brand">FAQ</span>
      <h2 class="mt-5 text-h2">
        Questions, <span class="font-serif font-normal tracking-[-0.02em]">answered.</span>
      </h2>
      <p class="mt-5 max-w-xs text-body text-muted-ink">
        Anything else, write to the team. A person replies, not a ticket bot.
      </p>
      <a
        class="mt-7 inline-flex items-center gap-2 text-label text-muted-ink transition-colors hover:text-ink"
        href={href("/help/")}
      >
        Read the help docs
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <FaqList faqs={[...faqs]} client:idle />
  </div>
</section>
