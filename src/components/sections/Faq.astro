---
const { data, id, Content } = Astro.props;
---

<section class="mx-auto max-w-5xl px-8 py-lg" id={id}>
  <h2 class="mb-md text-h2 tracking-tight">{data.heading}</h2>
  <div class="prose mb-md max-w-none dark:prose-invert prose-a:text-accent"><Content /></div>
  <div class="space-y-sm">
    {data.items.map((i) => (
      <details class="rounded-lg border border-tertiary p-5 open:bg-surface dark:border-neutral-800 dark:open:bg-neutral-900">
        <summary class="cursor-pointer text-label">{i.question}</summary>
        <p class="mt-3 text-body-sm text-secondary dark:text-neutral-400">{i.answer}</p>
      </details>
    ))}
  </div>
</section>
