---
import Accordion from "../ui/Accordion.astro";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";
const faqs = [
  { question: "Does Orso store my content in a separate CMS database?", answer: "No. For configured Astro content collections, Orso edits the Markdown files in your site project." },
  { question: "Can I change more than blog posts?", answer: "Yes. The Content tab edits supported collections, and the agent can help change the site's copy, components, styles, and code." },
  { question: "Can I use an existing site?", answer: "You can open a project from GitHub. To edit Astro content collections in the CMS, the project needs the Orso Astro integration and supported collection loaders." },
  { question: "How does publishing work?", answer: "For a GitHub-backed site, Orso lets you make a change, share a preview, and publish through the repository's existing workflow. Your site's hosting and deployment remain your choice." },
];
---

<Section id="faq" tone="muted" rule>
  <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    <SectionHeader label="FAQ" description="How content, code, and publishing work in Orso.">
      Frequently<br /><span class="text-brand-muted">asked questions.</span>
    </SectionHeader>
    <Accordion items={faqs} />
  </div>
</Section>
