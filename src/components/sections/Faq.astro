---
const faqs = [
  { question: "Can I change the design?", answer: "Yes. The landing page is plain Astro components styled with Tailwind." },
  { question: "Where can I host it?", answer: "Anywhere that serves static files, including Cloudflare Pages." },
];
---

<section class="mx-auto max-w-5xl px-8 py-lg" id="faq">
  <h2 class="mb-md text-h2 tracking-tight">Frequently asked questions</h2>
  <div class="space-y-sm">
    {faqs.map((i) => (
      <details class="rounded-lg border border-tertiary p-5 open:bg-surface dark:border-neutral-800 dark:open:bg-neutral-900">
        <summary class="cursor-pointer text-label">{i.question}</summary>
        <p class="mt-3 text-body-sm text-secondary dark:text-neutral-400">{i.answer}</p>
      </details>
    ))}
  </div>
</section>
