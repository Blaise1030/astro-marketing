---
import Selection from "@/components/landing/Selection.astro";
import Accent from "@/components/landing/Accent.astro";
import { buttonVariants } from "@/components/ui/button";
import { href } from "@/lib/href";
import { site } from "@/site";
import ProductMockup from "./ProductMockup.astro";

const btn = "h-9 gap-1.5 rounded-[10px] px-3.5 text-[13.5px] font-medium tracking-[-0.01em]";
---

<section id="hero" class="flex scroll-mt-14 flex-col gap-14 px-6 pb-16 pt-20 sm:px-10 sm:pt-24">
  <div class="flex flex-col gap-7">
    <a
      class="group flex w-fit items-center gap-2.5 motion-safe:animate-hero-in"
      href={site.repo}
      rel="noopener"
    >
      <span class="rounded-md bg-brand px-1.5 py-0.5 font-mono text-[11.5px] leading-4 text-white">free</span>
      <span class="text-[13px] text-muted-ink transition-colors group-hover:text-ink">Open source on GitHub</span>
      <span aria-hidden="true" class="text-[13px] text-faint transition-transform group-hover:translate-x-0.5">→</span>
    </a>

    <h1 class="max-w-4xl text-h1 font-medium text-balance motion-safe:animate-hero-in" style="animation-delay:80ms">
      Edit your site with the{" "}
      <Selection label="agent / claude" cycle={["agent / claude", "agent / cursor", "agent / codex"]}>agent</Selection>{" "}
      you <Accent>already pay for</Accent>.
    </h1>

    <p
      class="max-w-xl text-[16.5px] leading-relaxed text-pretty text-muted-ink motion-safe:animate-hero-in"
      style="animation-delay:160ms"
    >
      Project Orso is a free desktop studio for Astro. Edit Markdown in a real UI or hand the change to your agent, preview every
      draft, and publish static files to the host you choose.
    </p>

    <div class="flex flex-wrap items-center gap-3 motion-safe:animate-hero-in" style="animation-delay:240ms">
      <a class={buttonVariants({ className: `btn-gloss ${btn}` })} href={href("/download/")}>Get Orso</a>
      <a class={buttonVariants({ variant: "ghost", className: `btn-quiet ${btn}` })} href={href("#how-it-works")}>
        <svg class="size-3 text-faint" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6 4v16a1 1 0 0 0 1.524.852l13-8a1 1 0 0 0 0-1.704l-13-8A1 1 0 0 0 6 4z"></path>
        </svg>
        See how it works
      </a>
      <span class="ml-1 font-mono text-[12px] text-faint">free forever · no account</span>
    </div>
  </div>

  <div class="frame motion-safe:animate-hero-in" style="animation-delay:320ms">
    <div class="frame-inner h-[28rem] md:h-[36rem]">
      <ProductMockup />
    </div>
  </div>
</section>
<script>
  // Rotate cycling labels with a short blur swap; skipped under reduced motion.
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>("[data-cycle]").forEach((el) => {
      const labels = el.dataset.cycle!.split("|");
      let i = Math.max(0, labels.indexOf(el.dataset.label ?? ""));
      window.setInterval(() => {
        el.style.opacity = "0";
        el.style.filter = "blur(4px)";
        window.setTimeout(() => {
          i = (i + 1) % labels.length;
          el.dataset.label = labels[i];
          el.style.opacity = "";
          el.style.filter = "";
        }, 200);
      }, 2400);
    });
  }
</script>
