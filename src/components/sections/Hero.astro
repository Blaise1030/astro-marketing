---
import { href } from "../../lib/href";
const { data, id, Content } = Astro.props;
---

<section class="mx-auto max-w-5xl px-8 py-24 text-center" id={id}>
  <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">{data.headline}</h1>
  {data.subheadline && <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-600 dark:text-neutral-400">{data.subheadline}</p>}
  <p class="mt-8 flex flex-wrap justify-center gap-4">
    <a
      class="inline-block rounded-lg border border-neutral-900 bg-neutral-900 px-5 py-2.5 font-semibold text-white dark:border-white dark:bg-white dark:text-neutral-900"
      href={href(data.cta.href)}>{data.cta.label}</a
    >
    {data.secondaryCta && (
      <a class="inline-block rounded-lg border border-current px-5 py-2.5 font-semibold" href={href(data.secondaryCta.href)}>
        {data.secondaryCta.label}
      </a>
    )}
  </p>
  <div class="prose mx-auto mt-8 dark:prose-invert"><Content /></div>
</section>
