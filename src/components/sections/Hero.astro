---
import Button from "../Button.astro";
import ProductPreview from "../ProductPreview.astro";
---

<section class="relative isolate overflow-hidden" id="hero">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 mx-auto h-96 max-w-5xl bg-radial-[ellipse_at_top] from-action-bottom/15 via-section-ink/0 to-section-ink/0"></div>
  <div class="mx-auto max-w-6xl px-6 py-section text-center sm:px-8 sm:py-section-wide">
    <p class="inline-flex items-center gap-2 rounded-full border border-brand-accent/20 bg-action-bottom/10 px-4 py-2 text-xs font-medium tracking-[0.02em] text-brand-accent"><span aria-hidden="true" class="size-1.5 rounded-full bg-brand-accent"></span>The workspace for your Astro site</p>
    <h1 class="mx-auto mt-7 max-w-5xl text-display font-semibold text-balance [font-optical-sizing:auto]">Your Astro site.<br /><span class="text-brand-accent">Easy to keep current.</span></h1>
    <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-brand-muted sm:text-xl">
      Edit posts and help articles in a friendly CMS that updates your Markdown files. Ask an agent for bigger site changes, preview the result, then share or publish.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4 pb-2">
      <Button href="#workflow">See how Orso works <span aria-hidden="true">↗</span></Button>
      <Button href="#content" variant="secondary">Explore the CMS</Button>
    </div>
    <p class="mt-6 text-sm text-brand-muted">Markdown content. Live preview. Your GitHub workflow.</p>
    <ProductPreview />
  </div>
</section>
