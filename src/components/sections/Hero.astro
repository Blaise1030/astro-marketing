---
import Button from "../Button.astro";
import ProductPreview from "../ProductPreview.astro";
const details = ["Your Markdown files", "Live preview", "Your GitHub workflow"];
---

<section class="hero-ambience overflow-hidden" id="hero">
  <div class="mx-auto max-w-6xl px-6 pb-12 pt-16 text-center sm:px-8 sm:pb-20 sm:pt-24">
    <p class="inline-flex items-center gap-2 rounded-full border border-section-line bg-section-panel px-3.5 py-1.5 text-xs font-medium text-brand-copy"><span aria-hidden="true" class="size-1.5 rounded-full bg-action-bottom"></span>A little more freedom for your Astro site</p>
    <h1 class="mx-auto mt-7 max-w-5xl text-display font-semibold text-balance">Your Astro site.<br /><span class="font-editorial font-normal italic text-brand-accent">Easy to keep current.</span></h1>
    <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-brand-muted sm:text-lg">A friendly Markdown CMS. An agent for the bigger changes. One place to edit, preview, and publish the site you own.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4 pb-1">
      <Button href="#workflow">See how Orso works <span aria-hidden="true">↗</span></Button>
      <Button href="#content" variant="secondary">Explore the CMS</Button>
    </div>
    <ul class="mt-7 flex flex-wrap justify-center gap-x-5 gap-y-2 text-xs text-brand-muted">
      {details.map((detail) => <li class="inline-flex items-center gap-1.5"><svg aria-hidden="true" class="size-3.5 text-brand-accent" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m3 8 3 3 7-7" /></svg>{detail}</li>)}
    </ul>
    <div class="mt-12 sm:mt-16"><ProductPreview /></div>
  </div>
</section>
