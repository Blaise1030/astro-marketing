---
import { href } from "../../lib/href";
---

<section class="mx-auto max-w-5xl px-8 py-24 text-center" id="hero">
  <p class="mb-4 text-sm font-semibold uppercase tracking-wide text-neutral-600 dark:text-neutral-400">The workspace for your Astro site</p>
  <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">Your Astro site, easy to keep current.</h1>
  <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-600 dark:text-neutral-400">
    Edit posts and help articles in a friendly CMS that updates your Markdown files. Ask an agent for bigger site changes, preview the result, then share or publish.
  </p>
  <p class="mt-8 flex flex-wrap justify-center gap-5 pb-3">
    <a class="inline-flex min-h-12 items-center justify-center rounded-xl border border-neutral-700 bg-linear-to-b from-action-top to-action-bottom px-6 py-3 font-semibold text-white shadow-action-raised transition-[transform,box-shadow,filter] duration-150 hover:-translate-y-0.5 hover:brightness-110 active:translate-y-[3px] active:shadow-action-pressed focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900 motion-reduce:transform-none motion-reduce:transition-none dark:focus-visible:outline-white" href={href("#workflow")}>See how Orso works</a>
    <a class="inline-flex min-h-12 items-center justify-center rounded-xl border border-neutral-300 bg-linear-to-b from-white to-neutral-100 px-6 py-3 font-semibold text-neutral-900 shadow-action-secondary transition-[transform,box-shadow,filter] duration-150 hover:-translate-y-0.5 hover:brightness-105 active:translate-y-[3px] active:shadow-action-secondary-pressed focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900 motion-reduce:transform-none motion-reduce:transition-none dark:border-neutral-600 dark:from-neutral-700 dark:to-neutral-800 dark:text-white dark:shadow-action-raised dark:active:shadow-action-pressed dark:focus-visible:outline-white" href={href("#content")}>Explore the CMS</a>
  </p>
</section>
