---
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import ProductPreview from "../ProductPreview.astro";
const details = ["Content stays in your repository", "Live preview", "Publishes via GitHub"];
---

<section id="hero" class="hero-glow overflow-hidden bg-inverse text-inverse-foreground">
  <Container class="pb-16 pt-36 sm:pb-24 sm:pt-44">
    <Badge tone="inverse">Markdown CMS and site agent for Astro</Badge>
    <SectionHeader level="h1" tone="inverse" description="Edit Markdown content, hand larger changes to an agent, review them in a live preview, and publish through your existing GitHub workflow." class="mt-6 [&_h1]:max-w-3xl [&_h1]:text-display">
      Your Astro site.<br /><span class="text-inverse-foreground/60">Easy to keep current.</span>
      <Fragment slot="actions">
        <Button href="#workflow">See how Orso works <span aria-hidden="true">↗</span></Button>
      </Fragment>
    </SectionHeader>
    <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-xs text-inverse-foreground/60">
      {details.map((detail) => <li class="inline-flex items-center gap-1.5"><svg aria-hidden="true" class="size-3.5 text-action-top" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m3 8 3 3 7-7" /></svg>{detail}</li>)}
    </ul>
    <div class="mt-14 sm:mt-20"><ProductPreview /></div>
  </Container>
</section>
