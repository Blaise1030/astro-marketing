---
import { href } from "../../lib/href";

const proof = [
  "Runs on your machine",
  "Astro-native",
  "Publishes to GitHub Pages",
  "Zero new subscriptions",
  "No lock-in",
];
---

<section class="bg-navy text-white" id="hero">
  <div class="mx-auto max-w-5xl px-8 pt-24 pb-16 text-center sm:pt-32">
    <p class="mb-8 inline-flex items-center gap-2 rounded-full border border-white/20 px-3 py-1 text-label text-white/70">
      <span class="size-1.5 rounded-full bg-accent"></span>
      Free &amp; open source
    </p>
    <h1 class="mx-auto max-w-4xl text-h1-sm sm:text-h1">
      Your site. Your repo.<br class="hidden sm:block" /> Your agent.
    </h1>
    <p class="mx-auto mt-md max-w-2xl text-lg text-white/70">
      Orso is a free, open-source studio for Astro sites. Edit content in a real UI, let Claude, Cursor or Codex make
      the change, preview it locally, publish to GitHub Pages — and keep everything in a repo you own.
    </p>
    <p class="mt-12 flex flex-wrap justify-center gap-3">
      <a
        class="inline-block rounded-lg bg-brand px-5 py-3 text-label text-on-brand transition-colors hover:bg-brand-pressed"
        href={href("#how-it-works")}>Start building</a
      >
      <a
        class="inline-block rounded-lg border border-white/25 px-5 py-3 text-label transition-colors hover:border-white"
        href={href("#features")}>See what it does</a
      >
    </p>
    <ul class="mt-10 flex flex-wrap justify-center gap-x-2 gap-y-1 text-label text-white/60">
      {
        proof.map((item, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && (
              <span aria-hidden="true" class="text-white/30">
                ·
              </span>
            )}
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
