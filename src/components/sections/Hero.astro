---
import { AgentChip } from "@/components/agent-chip";
import { buttonVariants } from "@/components/ui/button";
import { ContainerScroll } from "@/components/ui/container-scroll-animation";
import { Spotlight } from "@/components/ui/spotlight-new";
import { href } from "@/lib/href";
import { site } from "@/site";
import ProductMockup from "./ProductMockup.astro";
---

<section class="relative isolate overflow-hidden pt-24 sm:pt-32" id="hero">
  <!-- Backdrop: animated spotlight beams over a fading grid -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-hairline)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-hairline)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_70%_45%_at_50%_0%,#000_30%,transparent_100%)]"
    >
    </div>
    <Spotlight client:load />
  </div>

  <div class="shell relative z-10 text-center">
    <a
      class="group inline-flex items-center gap-2 rounded-full border border-hairline bg-panel/70 py-1 pl-1 pr-3 text-[0.72rem] text-muted-ink backdrop-blur transition-colors hover:border-hairline-strong hover:text-ink motion-safe:animate-hero-in"
      href={site.repo}
      rel="noopener"
    >
      <span class="rounded-full bg-brand/15 px-2 py-0.5 font-medium text-ink">Open source</span>
      Free forever, MIT on GitHub
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
    </a>

    <h1 class="mx-auto mt-8 max-w-5xl text-h1 motion-safe:animate-hero-in" style="animation-delay:120ms">
      Edit your Astro site with
      <span class="sr-only">Claude, Cursor or Codex</span>
      <span aria-hidden="true"><AgentChip client:load /></span>
      <span class="text-muted-ink">the agent you already pay for.</span>
    </h1>

    <p class="mx-auto mt-6 max-w-xl text-body text-muted-ink motion-safe:animate-hero-in" style="animation-delay:280ms">
      A free desktop studio for Astro. Edit Markdown in a real UI or hand the change to your agent, preview every draft
      locally, and publish static files to the host you choose — all in a repo you own.
    </p>

    <div
      class="mt-9 flex flex-wrap items-center justify-center gap-3 motion-safe:animate-hero-in"
      style="animation-delay:400ms"
    >
      <a
        class={buttonVariants({ size: "lg", className: "btn-gloss h-11 rounded-full px-6 text-[0.85rem]" })}
        href={href("/download/")}
      >
        Get Orso for macOS
      </a>
      <a
        class={buttonVariants({
          variant: "outline",
          size: "lg",
          className: "h-11 rounded-full border-hairline-strong bg-panel/60 px-6 text-[0.85rem] backdrop-blur",
        })}
        href={href("#how-it-works")}
      >
        See how it works
      </a>
    </div>
    <p class="mt-4 text-[0.72rem] text-faint motion-safe:animate-hero-in" style="animation-delay:480ms">
      Free · no account · works with your existing repo
    </p>
  </div>

  <!-- The product window tilts flat as you scroll -->
  <div class="relative z-10 -mt-24 sm:-mt-44">
    <ContainerScroll client:load titleComponent="">
      <ProductMockup />
    </ContainerScroll>
  </div>
</section>
