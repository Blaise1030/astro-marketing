---
import { HeroGlobe } from "@/components/hero-globe";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { href } from "@/lib/href";
import HeroDemo from "./HeroDemo.astro";
---

<section class="relative isolate overflow-hidden pb-20 pt-24 sm:pb-32 sm:pt-36" id="hero">
  <div class="shell relative z-10 text-center">
    <Badge
      variant="outline"
      className="motion-safe:animate-hero-in h-7 gap-2 rounded-full border-hairline bg-wash px-3 text-[0.7rem] font-normal tracking-wide text-muted-ink"
    >
      <span class="size-1.5 rounded-full bg-live"></span>
      Free &amp; open source
    </Badge>

    <h1 class="mx-auto mt-8 max-w-5xl text-h1">
      <span class="inline-block motion-safe:animate-hero-in" style="animation-delay:120ms">Your site.</span>{" "}
      <span class="block motion-safe:animate-hero-in sm:inline-block" style="animation-delay:240ms">Your repo.</span><br class="hidden sm:inline" />
      <span class="inline-block text-muted-ink motion-safe:animate-hero-in" style="animation-delay:360ms">Your agent.</span>
    </h1>

    <p class="mx-auto mt-6 max-w-lg text-body text-muted-ink motion-safe:animate-hero-in" style="animation-delay:480ms">
      A free desktop studio for Astro sites. Edit Markdown in a real UI, or ask Claude, Cursor or Codex. Preview every
      draft locally, publish static files to the host you choose — and keep everything in a repo you own.
    </p>

    <div class="mt-9 flex flex-wrap items-center justify-center gap-x-7 gap-y-4 motion-safe:animate-hero-in" style="animation-delay:560ms">
      <a
        class={buttonVariants({
          size: "lg",
          className: "btn-gloss h-10 rounded-full px-5 text-[0.82rem]",
        })}
        href={href("/download/")}
      >
        Get Orso
      </a>
      <a
        class="group inline-flex items-center gap-2 text-label text-muted-ink transition-colors hover:text-ink"
        href={href("#how-it-works")}
      >
        See how it works
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>
  </div>

  <div class="shell relative z-10 mt-14 sm:mt-20">
    <HeroDemo />
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-[260px] overflow-hidden sm:h-[360px]" aria-hidden="true">
    <HeroGlobe client:visible />
    <div class="absolute inset-x-0 bottom-0 h-44 bg-gradient-to-t from-ground via-ground/80 to-transparent"></div>
  </div>
</section>
