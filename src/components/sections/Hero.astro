---
import Button from "../Button.astro";
---

<section class="relative isolate overflow-hidden" id="hero">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 mx-auto h-96 max-w-5xl bg-radial-[ellipse_at_top] from-action-bottom/15 via-section-ink/0 to-section-ink/0"></div>
  <div class="mx-auto max-w-6xl px-6 py-section text-center sm:px-8 sm:py-section-wide">
    <p class="text-xs font-medium uppercase tracking-[0.2em] text-brand-accent">The workspace for your Astro site</p>
    <h1 class="mx-auto mt-8 max-w-4xl font-editorial text-5xl leading-[1.05] tracking-tight text-balance sm:text-7xl lg:text-8xl">Your Astro site,<br />easy to keep current.</h1>
    <p class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-brand-muted">
      Edit posts and help articles in a friendly CMS that updates your Markdown files. Ask an agent for bigger site changes, preview the result, then share or publish.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4 pb-2">
      <Button href="#workflow">See how Orso works <span aria-hidden="true">↗</span></Button>
      <Button href="#content" variant="secondary">Explore the CMS</Button>
    </div>
    <p class="mt-7 text-sm text-brand-muted">Markdown content. Live preview. Your GitHub workflow.</p>
  </div>
</section>
