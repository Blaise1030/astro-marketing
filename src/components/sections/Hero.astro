---
import Accent from "@/components/landing/Accent.astro";
import { buttonVariants } from "@/components/ui/button";
import { href } from "@/lib/href";
import { site } from "@/site";
import HeroVideo from "./HeroVideo.astro";

const btn = "h-9 gap-1.5 rounded-[10px] px-3.5 text-[13.5px] font-medium tracking-[-0.01em]";
---

<section id="hero" class="flex scroll-mt-14 flex-col gap-14 px-6 pb-16 pt-20 sm:px-10 sm:pt-24">
  <div class="flex flex-col gap-7">
    <a
      class="group flex w-fit items-center gap-2.5 motion-safe:animate-hero-in"
      href={site.repo}
      rel="noopener"
    >
      <span class="rounded-md bg-brand px-1.5 py-0.5 font-mono text-[11.5px] leading-4 text-white">alpha</span>
      <span class="text-[13px] text-muted-ink transition-colors group-hover:text-ink">Early days · free and open source on GitHub</span>
      <span aria-hidden="true" class="text-[13px] text-faint transition-transform group-hover:translate-x-0.5">→</span>
    </a>

    <h1 class="max-w-4xl text-h1 font-medium text-balance motion-safe:animate-hero-in" style="animation-delay:80ms">
      A shared workspace for <Accent>everyone who builds</Accent> your website.
    </h1>

    <p
      class="max-w-xl text-[16.5px] leading-relaxed text-pretty text-muted-ink motion-safe:animate-hero-in"
      style="animation-delay:160ms"
    >
      Bring code, content and AI agents into one Git-based project. Give writers and marketers the freedom to create
      pages and make changes, with shared previews and review before publishing. From first idea to live site, with fewer handoffs.
    </p>

    <div class="flex flex-wrap items-center gap-3 motion-safe:animate-hero-in" style="animation-delay:240ms">
      <a class={buttonVariants({ className: `btn-gloss ${btn}` })} href={href("/download/")}>Download Orso</a>
      <a class={buttonVariants({ variant: "ghost", className: `btn-quiet ${btn}` })} href="#demo" data-watch-demo>
        <svg class="size-3 text-faint" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6 4v16a1 1 0 0 0 1.524.852l13-8a1 1 0 0 0 0-1.704l-13-8A1 1 0 0 0 6 4z"></path>
        </svg>
        Watch the 35-second demo
      </a>
      <span class="ml-1 font-mono text-[12px] text-faint">for Astro sites · free &amp; open source</span>
    </div>
  </div>

  <div id="demo" class="frame scroll-mt-20 motion-safe:animate-hero-in" style="animation-delay:320ms">
    <!-- Same ratio as the recording (1920x1044), so it is never cropped -->
    <div class="frame-inner aspect-[1920/1044]">
      <HeroVideo />
    </div>
  </div>
  <p class="-mt-9 text-[13px] text-muted-ink">See Orso in action: ask for a change, edit content, preview, then publish.</p>
</section>
<script>
  document.querySelector("[data-watch-demo]")?.addEventListener("click", () => {
    document.querySelector<HTMLButtonElement>("[data-hero-play]")?.click();
  });
</script>
