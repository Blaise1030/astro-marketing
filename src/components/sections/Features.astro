---
const pillars = [
  {
    shape: "circle",
    title: "Write",
    body: "Copy, blog posts and help articles get friendly forms. Markdown is still there when you want it.",
  },
  {
    shape: "square",
    title: "Ask",
    body: "Describe a bigger change in plain English. Claude, Cursor or Codex writes the code and the styles.",
  },
  {
    shape: "triangle",
    title: "Preview",
    body: "Every edit lives in its own draft with a live desktop and mobile preview, so nothing leaks early.",
  },
  {
    shape: "hexagon",
    title: "Publish",
    body: "One click to GitHub Pages. History keeps a checkpoint of every save, one click away.",
  },
] as const;
---

<section class="shell py-20 sm:py-section" id="features">
  <h2 class="max-w-3xl text-h2">
    Everything in one studio.<br />
    <span class="text-muted-ink">Nothing in between.</span>
  </h2>
  <p class="mt-5 max-w-lg text-body text-muted-ink">
    Write, ask, preview and publish from the same place. No terminal, no build pipeline to babysit.
  </p>

  <div class="mt-14 sm:mt-20">
    <div class="relative overflow-hidden border-y border-hairline">
      <div class="pointer-events-none absolute inset-0 wash-top"></div>
      <div class="relative grid grid-cols-2 lg:grid-cols-4">
        {
          pillars.map((pillar) => (
            <div class="flex h-40 items-center justify-center border-hairline [&:not(:nth-child(2n))]:border-r [&:nth-child(-n+2)]:border-b sm:h-52 lg:h-60 lg:[&:not(:nth-child(4n))]:border-r lg:[&:nth-child(-n+2)]:border-b-0">
              <svg
                viewBox="0 0 100 100"
                class="size-20 text-mark sm:size-24 md:size-28"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                aria-hidden="true"
              >
                {pillar.shape === "circle" && <circle cx="50" cy="50" r="46" />}
                {pillar.shape === "square" && <rect x="6" y="6" width="88" height="88" />}
                {pillar.shape === "triangle" && <path d="M50 6 94 90H6Z" />}
                {pillar.shape === "hexagon" && <path d="M50 4 90 27v46L50 96 10 73V27Z" />}
              </svg>
            </div>
          ))
        }
      </div>
    </div>

    <div class="grid grid-cols-2 gap-x-8 gap-y-10 pt-8 lg:grid-cols-4">
      {
        pillars.map((pillar) => (
          <div>
            <h3 class="text-h3">{pillar.title}</h3>
            <p class="mt-2 max-w-56 text-body text-muted-ink">{pillar.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
