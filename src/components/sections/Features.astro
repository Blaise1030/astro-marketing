---
const card =
  "group relative overflow-hidden rounded-2xl border border-hairline bg-panel p-6 transition-colors duration-300 hover:border-hairline-strong hover:bg-raised sm:p-7";
const visual = "mb-6 flex h-44 items-center justify-center overflow-hidden rounded-xl border border-hairline bg-ground";
---

<section class="shell py-20 sm:py-section" id="features">
  <div data-reveal>
    <h2 class="max-w-3xl text-h2">
      Everything in one studio.<br />
      <span class="text-muted-ink">Nothing in between.</span>
    </h2>
    <p class="mt-5 max-w-lg text-body text-muted-ink">
      Write, ask, preview and publish from the same place — built for developers with an agent, and for teammates who just need a form.
    </p>
  </div>

  <div class="mt-14 grid gap-4 sm:mt-20 lg:grid-cols-6">
    <!-- Preview -->
    <div class:list={[card, "lg:col-span-4"]} data-reveal>
      <div class={visual} aria-hidden="true">
        <div class="flex items-end gap-5">
          <div class="h-32 w-56 rounded-lg border border-hairline-strong bg-panel p-3 transition-transform duration-500 group-hover:-translate-y-1">
            <div class="h-2 w-1/3 rounded-full bg-hairline-strong"></div>
            <div class="mt-3 h-12 rounded-md bg-brand/15"></div>
            <div class="mt-3 h-1.5 w-4/5 rounded-full bg-hairline"></div>
            <div class="mt-1.5 h-1.5 w-3/5 rounded-full bg-hairline"></div>
          </div>
          <div class="h-28 w-14 rounded-lg border border-hairline-strong bg-panel p-2 transition-transform delay-75 duration-500 group-hover:-translate-y-1">
            <div class="h-8 rounded-sm bg-brand/15"></div>
            <div class="mt-2 h-1.5 w-full rounded-full bg-hairline"></div>
            <div class="mt-1.5 h-1.5 w-2/3 rounded-full bg-hairline"></div>
          </div>
        </div>
      </div>
      <h3 class="text-h3">Preview</h3>
      <p class="mt-2 max-w-md text-body text-muted-ink">
        Every edit lives in its own draft with a live desktop and mobile preview, so nothing leaks early.
      </p>
    </div>

    <!-- Ask -->
    <div class:list={[card, "lg:col-span-2"]} data-reveal style="--d: 100ms">
      <div class={visual} aria-hidden="true">
        <div class="w-44 space-y-2 text-[0.65rem]">
          <p class="ml-auto w-fit rounded-xl rounded-br-sm border border-hairline bg-raised px-2.5 py-1.5 text-ink">Make the hero bolder</p>
          <p class="w-fit rounded-xl rounded-bl-sm border border-brand/40 bg-brand/10 px-2.5 py-1.5 text-muted-ink">
            Done<span class="ml-0.5 inline-block h-2.5 w-px translate-y-0.5 bg-brand motion-safe:animate-caret"></span>
          </p>
        </div>
      </div>
      <h3 class="text-h3">Ask</h3>
      <p class="mt-2 text-body text-muted-ink">Describe a bigger change in plain English. Claude, Cursor or Codex writes the code and the styles.</p>
    </div>

    <!-- Write -->
    <div class:list={[card, "lg:col-span-2"]} data-reveal style="--d: 0ms">
      <div class={visual} aria-hidden="true">
        <div class="w-44 space-y-2.5 text-[0.65rem]">
          <div class="rounded-md border border-hairline-strong bg-panel px-2.5 py-1.5 text-ink">Product launch</div>
          <div class="flex gap-2">
            <div class="flex-1 rounded-md border border-hairline bg-panel px-2.5 py-1.5 text-faint">2026-11-15</div>
            <div class="rounded-md border border-hairline bg-panel px-2.5 py-1.5 text-brand">news</div>
          </div>
          <div class="h-1.5 w-full rounded-full bg-hairline"></div>
          <div class="h-1.5 w-2/3 rounded-full bg-hairline"></div>
        </div>
      </div>
      <h3 class="text-h3">Write</h3>
      <p class="mt-2 text-body text-muted-ink">Copy, blog posts and help articles get friendly forms. Markdown is still there when you want it.</p>
    </div>

    <!-- Publish -->
    <div class:list={[card, "lg:col-span-2"]} data-reveal style="--d: 100ms">
      <div class={visual} aria-hidden="true">
        <ul class="w-44 space-y-2 font-mono text-[0.65rem] text-muted-ink">
          <li class="flex justify-between"><span>build</span><span class="text-live">✓ 4.1s</span></li>
          <li class="flex justify-between"><span>upload</span><span class="text-live">✓ 38 files</span></li>
          <li class="flex justify-between text-ink"><span>live</span><span class="flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-live"></span>your-site.com</span></li>
        </ul>
      </div>
      <h3 class="text-h3">Publish</h3>
      <p class="mt-2 text-body text-muted-ink">Ship static files to the host you already use. No lock-in, no runtime.</p>
    </div>

    <!-- History -->
    <div class:list={[card, "lg:col-span-2"]} data-reveal style="--d: 200ms">
      <div class={visual} aria-hidden="true">
        <ul class="relative w-44 space-y-3 pl-5 font-mono text-[0.65rem] text-muted-ink before:absolute before:left-[3px] before:top-1.5 before:bottom-1.5 before:w-px before:bg-hairline-strong">
          <li class="relative text-ink"><span class="absolute -left-5 top-1 size-[7px] rounded-full bg-brand"></span>Add pricing page</li>
          <li class="relative"><span class="absolute -left-5 top-1 size-[7px] rounded-full bg-hairline-strong"></span>Tweak hero copy</li>
          <li class="relative"><span class="absolute -left-5 top-1 size-[7px] rounded-full bg-hairline-strong"></span>Publish v1</li>
        </ul>
      </div>
      <h3 class="text-h3">History</h3>
      <p class="mt-2 text-body text-muted-ink">A checkpoint of every save, in a git repo you own. Roll back any time.</p>
    </div>
  </div>
</section>
