---
import { GlowingEffect } from "@/components/ui/glowing-effect";

const visual = "flex h-40 items-center justify-center overflow-hidden rounded-lg border border-hairline bg-ground";
const features = [
  { id: "write", title: "Forms, not frontmatter", body: "Blog posts, help docs and copy get friendly fields. Markdown is still there when you want it." },
  { id: "ask", title: "Your agent, in the loop", body: "Describe a change in plain English. Claude, Cursor or Codex writes the code and the styles." },
  { id: "preview", title: "Every draft, previewed", body: "Each edit lives in its own draft with a live desktop and mobile preview, so nothing leaks early." },
  { id: "publish", title: "Static files, any host", body: "Ship plain static output to the host you already use. No runtime, no lock-in." },
  { id: "history", title: "Branch it like code", body: "A checkpoint of every save in a git repo you own. Roll back whenever you like." },
  { id: "repo", title: "No migration", body: "Orso opens the Astro project you already have. Your content stays Markdown in your repo." },
];
---

<section class="shell py-20 sm:py-section" id="features">
  <div class="grid gap-5 lg:grid-cols-2 lg:items-end" data-reveal>
    <h2 class="max-w-xl text-h2">
      Stop rebuilding<br />
      <span class="text-muted-ink">what already exists.</span>
    </h2>
    <p class="max-w-md text-body text-muted-ink lg:justify-self-end">
      Write, ask, preview and publish from one studio — built for developers with an agent, and for teammates who just
      need a form.
    </p>
  </div>

  <ul class="mt-14 grid gap-4 sm:mt-16 md:grid-cols-2 lg:grid-cols-3">
    {
      features.map((f, i) => (
        <li class="relative list-none rounded-2xl border border-hairline p-2 md:rounded-3xl md:p-2.5" data-reveal style={`--d: ${(i % 3) * 100}ms`}>
          <GlowingEffect client:visible spread={40} glow disabled={false} proximity={64} inactiveZone={0.01} borderWidth={2} />
          <div class="relative flex h-full flex-col overflow-hidden rounded-xl bg-panel p-5 md:rounded-2xl">
            <div class={visual} aria-hidden="true">
              {f.id === "write" && (
                <div class="w-48 space-y-2.5 text-[0.65rem]">
                  <div class="rounded-md border border-hairline-strong bg-panel px-2.5 py-1.5 text-ink">Product launch</div>
                  <div class="flex gap-2">
                    <div class="flex-1 rounded-md border border-hairline bg-panel px-2.5 py-1.5 text-faint">2026-11-15</div>
                    <div class="rounded-md border border-hairline bg-panel px-2.5 py-1.5 text-brand">news</div>
                  </div>
                  <div class="h-1.5 w-full rounded-full bg-hairline" />
                  <div class="h-1.5 w-2/3 rounded-full bg-hairline" />
                </div>
              )}
              {f.id === "ask" && (
                <div class="w-48 space-y-2 text-[0.65rem]">
                  <p class="ml-auto w-fit rounded-xl rounded-br-sm border border-hairline bg-raised px-2.5 py-1.5 text-ink">Make the hero bolder</p>
                  <p class="w-fit rounded-xl rounded-bl-sm border border-brand/40 bg-brand/10 px-2.5 py-1.5 text-muted-ink">
                    Updated Hero.astro<span class="ml-0.5 inline-block h-2.5 w-px translate-y-0.5 bg-brand motion-safe:animate-caret" />
                  </p>
                </div>
              )}
              {f.id === "preview" && (
                <div class="flex items-end gap-3">
                  <div class="h-24 w-40 rounded-md border border-hairline-strong bg-panel p-2.5">
                    <div class="h-1.5 w-1/3 rounded-full bg-hairline-strong" />
                    <div class="mt-2 h-9 rounded-sm bg-brand/20" />
                    <div class="mt-2 h-1.5 w-4/5 rounded-full bg-hairline" />
                  </div>
                  <div class="h-20 w-11 rounded-md border border-hairline-strong bg-panel p-1.5">
                    <div class="h-6 rounded-sm bg-brand/20" />
                    <div class="mt-1.5 h-1 w-full rounded-full bg-hairline" />
                  </div>
                </div>
              )}
              {f.id === "publish" && (
                <ul class="w-48 space-y-2 font-mono text-[0.65rem] text-muted-ink">
                  <li class="flex justify-between"><span>build</span><span class="text-live">✓ 4.1s</span></li>
                  <li class="flex justify-between"><span>upload</span><span class="text-live">✓ 38 files</span></li>
                  <li class="flex justify-between text-ink"><span>live</span><span class="flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-live" />your-site.com</span></li>
                </ul>
              )}
              {f.id === "history" && (
                <ul class="relative w-48 space-y-3 pl-5 font-mono text-[0.65rem] text-muted-ink before:absolute before:bottom-1.5 before:left-[3px] before:top-1.5 before:w-px before:bg-hairline-strong">
                  <li class="relative text-ink"><span class="absolute -left-5 top-1 size-[7px] rounded-full bg-brand" />Add pricing page</li>
                  <li class="relative"><span class="absolute -left-5 top-1 size-[7px] rounded-full bg-hairline-strong" />Tweak hero copy</li>
                  <li class="relative"><span class="absolute -left-5 top-1 size-[7px] rounded-full bg-hairline-strong" />Publish v1</li>
                </ul>
              )}
              {f.id === "repo" && (
                <ul class="w-48 space-y-1.5 font-mono text-[0.65rem] text-muted-ink">
                  <li>▾ src/</li>
                  <li class="pl-4">▾ content/blog/en/</li>
                  <li class="pl-8 text-ink">launch.md</li>
                  <li class="pl-4">▸ pages/</li>
                  <li>astro.config.mjs</li>
                </ul>
              )}
            </div>
            <h3 class="mt-5 text-h3">{f.title}</h3>
            <p class="mt-2 text-body text-muted-ink">{f.body}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
