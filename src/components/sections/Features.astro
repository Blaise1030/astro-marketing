---
const features = [
  {
    title: "Bring your own agent",
    description:
      "Runs on Claude, Cursor or Codex. The AI subscription you already pay for becomes the thing that builds your site.",
  },
  {
    title: "Own your content",
    description:
      "Posts and pages are Markdown in your own Git repo. Walk away with a working site whenever you like.",
  },
  {
    title: "Open source, all of it",
    description:
      "Free to use, read, fork and self-host. No license server, no per-seat core, no lock-in.",
  },
  {
    title: "An editor for the people who write",
    description:
      "Copy, blog posts and help articles get friendly forms. Markdown is still there if you want it.",
  },
  {
    title: "Every change is previewed",
    description:
      "Edits live in their own draft with a live desktop and mobile preview, so experiments never leak onto the live site.",
  },
  {
    title: "Publish and undo",
    description:
      "Ship to GitHub Pages in one click. History keeps a checkpoint of every save, so any version is one click away.",
  },
];
---

<section class="mx-auto max-w-5xl px-8 py-lg" id="features">
  <div class="max-w-2xl">
    <h2 class="text-h2">One studio, the whole loop</h2>
    <p class="mt-3 text-lg text-secondary">
      Built so nobody on the team needs a terminal — and nothing is locked in.
    </p>
  </div>
  <div class="mt-10 grid grid-cols-[repeat(auto-fit,minmax(16rem,1fr))] gap-md">
    {
      features.map((feature) => (
        <div class="rounded-xl border border-tertiary/30 p-md">
          <h3 class="text-lg font-semibold">{feature.title}</h3>
          <p class="mt-2 text-secondary">{feature.description}</p>
        </div>
      ))
    }
  </div>
</section>
