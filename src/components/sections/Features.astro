---
const features = [
  {
    title: "Chat instead of clicking",
    description: "Describe the change in plain words. The agent writes the code, copy and styles for you.",
  },
  {
    title: "Changes keep experiments safe",
    description: "Every edit lives in its own change, so work in progress never leaks onto the live site.",
  },
  {
    title: "Live preview, real site",
    description: "See the actual site update as you work, on desktop and mobile — no staging setup to babysit.",
  },
  {
    title: "Content without Markdown",
    description: "Blog posts and help articles get friendly forms. Markdown is there if you want it.",
  },
  {
    title: "Design that stays consistent",
    description: "Adjust colours, type and spacing once; every page follows the same tokens.",
  },
  {
    title: "Nothing is ever lost",
    description: "Every save is a checkpoint. Restore any earlier version from History in one click.",
  },
];
---

<section class="mx-auto max-w-5xl px-8 py-lg" id="features">
  <div class="max-w-2xl">
    <h2 class="text-h2">Everything you need to ship a site</h2>
    <p class="mt-3 text-lg text-secondary">
      The agent does the editing. Orso keeps the work safe, visible and reversible.
    </p>
  </div>
  <div class="mt-10 grid grid-cols-[repeat(auto-fit,minmax(16rem,1fr))] gap-md">
    {
      features.map((feature) => (
        <div class="rounded-xl border border-tertiary/30 p-md">
          <h3 class="text-lg font-semibold">{feature.title}</h3>
          <p class="mt-2 text-secondary">{feature.description}</p>
        </div>
      ))
    }
  </div>
</section>
