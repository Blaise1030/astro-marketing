---
const { data, id, Content } = Astro.props;
---

<section class="mx-auto max-w-5xl px-8 py-lg" id={id}>
  <h2 class="mb-md text-h2 tracking-tight">{data.heading}</h2>
  <div class="prose mb-md max-w-none dark:prose-invert prose-a:text-accent"><Content /></div>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-md">
    {data.items.map((i) => (
      <div class="rounded-lg border border-tertiary p-5 dark:border-neutral-800">
        <h3 class="mb-2 text-lg font-semibold">{i.title}</h3>
        <p class="text-body-sm text-secondary dark:text-neutral-400">{i.description}</p>
      </div>
    ))}
  </div>
</section>
