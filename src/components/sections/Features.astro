---
import SectionIntro from "@/components/landing/SectionIntro.astro";
import Accent from "@/components/landing/Accent.astro";
import { href } from "@/lib/href";

const features = [
  { id: "write", title: "Forms, not frontmatter", body: "Blog posts, help docs and page copy get real fields. Markdown is still one click away." },
  { id: "ask", title: "Your agent, in the loop", body: "Describe a change in plain English. Claude, Cursor or Codex edits the repo, never the live site." },
  { id: "preview", title: "Every draft, previewed", body: "Each change gets its own draft with a live desktop and mobile preview, so nothing ships early." },
  { id: "publish", title: "Static files, any host", body: "Publish plain static output through the workflow you already have. No runtime, no lock-in." },
  { id: "history", title: "Review before it's live", body: "Drafts wait for a yes. Your team approves, then publishes, and every earlier version stays one click away." },
  { id: "repo", title: "Images are just files", body: "Upload an image and it lands in the repo next to the post. No media library, no CDN bill, nothing to migrate." },
];

// Dashed grid rules: 1 column → 2 (md) → 3 (xl), with the outer gutters trimmed.
const cell = [
  "md:border-t-0 md:border-l-0 md:pl-0 xl:pr-8 xl:pl-0",
  "border-t md:border-t-0 md:border-l md:pr-0 xl:border-l xl:px-8",
  "border-t md:border-l-0 md:pl-0 xl:border-t-0 xl:border-l xl:pr-0 xl:pl-8",
  "border-t md:border-l md:pr-0 xl:border-l-0 xl:pr-8 xl:pl-0",
  "border-t md:border-l-0 md:pl-0 xl:border-l xl:px-8",
  "border-t md:border-l md:pr-0 xl:border-l xl:pr-0 xl:pl-8",
];
// Real Orso screenshots per card, light + dark (`-dark`), captured at 2x from a demo project.
const shots: Record<string, { src: string; w: number; h: number }[]> = {
  write: [{ src: "write", w: 574, h: 400 }],
  ask: [{ src: "ask", w: 632, h: 540 }],
  preview: [{ src: "preview", w: 900, h: 862 }],
  publish: [
    { src: "publish-a", w: 446, h: 90 },
    { src: "publish-b", w: 746, h: 140 },
  ],
  history: [{ src: "review", w: 608, h: 390 }],
  repo: [{ src: "repo", w: 574, h: 512 }],
};
---

<section id="features" class="flex scroll-mt-14 flex-col gap-14 px-6 py-20 sm:px-10">
  <div data-reveal>
    <SectionIntro tag="Studio">
      Everything your team needs to <Accent>run the site</Accent>.
      <Fragment slot="lead">
        And nothing they have to learn first. Fields that match the page, an agent for the bigger changes, and a
        preview of every draft. The page they edit is the page that ships.
      </Fragment>
    </SectionIntro>
  </div>

  <div class="grid md:grid-cols-2 xl:grid-cols-3">
    {
      features.map((f, i) => (
        <div
          class:list={["flex flex-col gap-6 border-dashed border-hairline-strong py-8 md:px-8", cell[i]]}
          data-reveal
          style={`--d: ${(i % 3) * 90}ms`}
        >
          <div class="dot-well relative flex h-60 flex-col items-center justify-center gap-3 overflow-hidden rounded-[14px] px-5" aria-hidden="true">
            {shots[f.id].map((s) => (
              <div class="float-card max-w-full overflow-hidden rounded-xl">
                <img
                  src={href(`/product/features/${s.src}.webp`)}
                  width={s.w / 2}
                  height={s.h / 2}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="block h-auto max-h-[200px] w-auto max-w-full dark:hidden"
                />
                <img
                  src={href(`/product/features/${s.src}-dark.webp`)}
                  width={s.w / 2}
                  height={s.h / 2}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="hidden h-auto max-h-[200px] w-auto max-w-full dark:block"
                />
              </div>
            ))}
          </div>
          <div class="flex flex-col gap-2">
            <h3 class="text-[17px] font-medium tracking-[-0.02em]">{f.title}</h3>
            <p class="text-[14.5px] leading-relaxed text-pretty text-muted-ink">{f.body}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
