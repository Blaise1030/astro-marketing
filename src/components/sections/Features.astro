---
const features = [
  { title: "Fast by default", description: "Static pages that load instantly on any device." },
  { title: "Easy to edit", description: "Change copy in plain files; the layout takes care of itself." },
  { title: "Ready to deploy", description: "Build once and publish anywhere static sites are hosted." },
];
---

<section class="mx-auto max-w-5xl px-8 py-lg" id="features">
  <h2 class="mb-md text-h2 tracking-tight">Everything you need to launch</h2>
  <p class="mb-md">Three reasons teams pick Acme.</p>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-md">
    {features.map((f) => (
      <div class="rounded-lg border border-tertiary p-5 dark:border-neutral-800">
        <h3 class="mb-2 text-lg font-semibold">{f.title}</h3>
        <p class="text-body-sm text-secondary dark:text-neutral-400">{f.description}</p>
      </div>
    ))}
  </div>
</section>
