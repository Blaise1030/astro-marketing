---
import Accent from "@/components/landing/Accent.astro";
import SectionIntro from "@/components/landing/SectionIntro.astro";
import { href } from "@/lib/href";
const reasons = [
  { title: "One source of truth", body: "Content lives alongside pages, components and images in your GitHub repository. Everyone works from the same project." },
  { title: "A shared history", body: "See what changed and return to an earlier version when you need to. Your files remain yours if you stop using Orso." },
  { title: "One publishing process", body: "People and agents work through drafts, previews and review, using the publishing workflow your developers maintain." },
];
---
<section id="about" class="flex scroll-mt-14 flex-col gap-12 px-6 py-20 sm:px-10">
  <div data-reveal><SectionIntro tag="Shared project">
    One project for <Accent>the whole website</Accent>.
    <Fragment slot="lead">Your content lives alongside your pages and components. Writers, developers and agents work from the same source, without a separate CMS content store to keep in sync.</Fragment>
  </SectionIntro></div>
  <div class="frame" data-reveal><div class="frame-inner flex flex-col gap-6 p-6 sm:p-8">
    <p class="text-[14px] font-medium">Your Git-based project</p>
    <div class="grid gap-3 sm:grid-cols-3">
      {["Content and articles", "Pages and components", "Images and assets"].map(label => <div class="rounded-xl border border-hairline-strong bg-panel px-4 py-5 text-[14px]">{label}</div>)}
    </div>
    <ol class="flex flex-wrap items-center justify-center gap-4 border-t border-dashed border-hairline-strong pt-6 text-[14px] font-medium" aria-label="Publishing process">
      <li>Draft</li><li aria-hidden="true" class="text-faint">→</li><li>Shared preview</li><li aria-hidden="true" class="text-faint">→</li><li>Review</li><li aria-hidden="true" class="text-faint">→</li><li>Publish</li>
    </ol>
  </div></div>
  <div class="grid gap-8 md:grid-cols-3" data-reveal>{reasons.map(reason => <div class="flex flex-col gap-3"><h3 class="text-[18px] font-medium">{reason.title}</h3><p class="text-[14.5px] leading-relaxed text-muted-ink">{reason.body}</p></div>)}</div>
  <p class="max-w-2xl text-[14px] leading-relaxed text-muted-ink">Each teammate opens the project locally in Orso and shares changes through GitHub. <a href={href("/help/work-with-your-team/")} class="text-link underline underline-offset-4">See how your team works together</a>.</p>
</section>
