---
// Framed product demo. Drop `hero-demo.webm` / `hero-demo.mp4` (and optionally
// `hero-demo-poster.jpg`) into /public; until they exist the video layer hides
// itself and the stylised stand-in underneath stays visible.
import { href } from "@/lib/href";
---

<div
  class="group relative mx-auto w-full max-w-5xl motion-safe:animate-hero-rise"
  style="animation-delay: 650ms"
  data-hero-demo
>
  <div
    class="pointer-events-none absolute -inset-x-10 -top-10 bottom-10 -z-10 rounded-full bg-brand/25 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative overflow-hidden rounded-2xl border border-hairline-strong bg-panel shadow-[0_40px_120px_-30px_rgb(47_108_236/0.45)]"
  >
    <div class="flex items-center gap-3 border-b border-hairline bg-raised px-4 py-2.5">
      <div class="flex gap-1.5" aria-hidden="true">
        <span class="size-2.5 rounded-full bg-hairline-strong"></span>
        <span class="size-2.5 rounded-full bg-hairline-strong"></span>
        <span class="size-2.5 rounded-full bg-hairline-strong"></span>
      </div>
      <span class="mx-auto font-mono text-[0.68rem] text-faint">orso — your-site</span>
      <span class="flex items-center gap-1.5 text-[0.65rem] text-faint">
        <span class="size-1.5 rounded-full bg-live"></span>Preview live
      </span>
    </div>

    <div class="relative aspect-[16/9] bg-ground">
      <!-- Stand-in shown until the recording is added -->
      <div class="absolute inset-0 grid grid-cols-[1fr_1.4fr] text-left" aria-hidden="true">
        <div class="flex flex-col gap-3 border-r border-hairline p-5 sm:p-7">
          <span class="text-[0.65rem] uppercase tracking-widest text-faint">Agent</span>
          <p class="rounded-lg border border-hairline bg-panel px-3 py-2.5 font-mono text-[0.72rem] text-ink sm:text-xs">
            Add a pricing page with three tiers<span class="ml-0.5 inline-block h-3 w-px translate-y-0.5 bg-brand motion-safe:animate-caret"></span>
          </p>
          <div class="space-y-2 pt-2 font-mono text-[0.68rem] text-muted-ink">
            <p><span class="text-live">+</span> src/content/pricing.md</p>
            <p><span class="text-live">+</span> src/pages/pricing.astro</p>
            <p><span class="text-brand">~</span> src/site.ts</p>
          </div>
        </div>
        <div class="p-5 sm:p-7">
          <span class="text-[0.65rem] uppercase tracking-widest text-faint">Live preview</span>
          <div class="mt-3 space-y-3 rounded-lg border border-hairline bg-panel p-4">
            <div class="h-3 w-2/5 rounded-full bg-hairline-strong"></div>
            <div class="h-2 w-4/5 rounded-full bg-hairline"></div>
            <div class="grid grid-cols-3 gap-3 pt-3">
              <div class="h-24 rounded-md border border-hairline bg-raised"></div>
              <div class="h-24 rounded-md border border-brand/60 bg-brand/10"></div>
              <div class="h-24 rounded-md border border-hairline bg-raised"></div>
            </div>
          </div>
        </div>
      </div>

      <video
        class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-700"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={href("/hero-demo-poster.jpg")}
        aria-label="Screen recording of Orso: an agent builds a page and the preview updates live"
        data-hero-video
      >
        <source src={href("/hero-demo.webm")} type="video/webm" />
        <source src={href("/hero-demo.mp4")} type="video/mp4" />
      </video>
    </div>

    <!-- Cursor spotlight -->
    <div
      class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
      style="background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 0%), rgb(111 150 245 / 0.14), transparent 70%)"
      aria-hidden="true"
    >
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-hero-demo]");
  const video = root?.querySelector<HTMLVideoElement>("[data-hero-video]");

  if (root) {
    root.addEventListener("pointermove", (e) => {
      const r = root.getBoundingClientRect();
      root.style.setProperty("--mx", `${e.clientX - r.left}px`);
      root.style.setProperty("--my", `${e.clientY - r.top}px`);
    });
  }

  if (video) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const show = () => video.classList.remove("opacity-0");
    // No file yet: a failed last <source> leaves the stand-in visible.
    if (reduced) {
      video.removeAttribute("autoplay");
      video.pause();
    }
    video.addEventListener("loadeddata", show, { once: true });
    video.addEventListener("error", () => video.remove(), { once: true });
    video.querySelector("source:last-of-type")?.addEventListener("error", () => video.remove());
    // Pause offscreen to save battery.
    new IntersectionObserver(([entry]) => {
      if (reduced) return;
      if (entry.isIntersecting) void video.play().catch(() => {});
      else video.pause();
    }).observe(video);
  }
</script>
