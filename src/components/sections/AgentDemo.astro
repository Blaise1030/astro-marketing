---
import { toolLogos } from "@/lib/tool-logos";

const agents = [
  { name: "Claude", logo: toolLogos.claude, active: true },
  { name: "Cursor", logo: toolLogos.cursor, active: false },
  { name: "Codex", logo: toolLogos.codex, active: false },
];
---

<section class="shell py-20 sm:py-section" id="agent">
  <div class="mx-auto max-w-2xl text-center" data-reveal>
    <p class="text-eyebrow uppercase text-faint">Ask your agent</p>
    <h2 class="mt-4 text-h2">
      Describe it.<br />
      <span class="text-muted-ink">Watch it ship to a draft.</span>
    </h2>
  </div>

  <div
    class="mx-auto mt-12 max-w-3xl overflow-hidden rounded-2xl border border-hairline-strong bg-panel text-left shadow-[0_30px_100px_-40px_rgb(47_108_236/0.5)]"
    data-reveal
    style="--d: 120ms"
  >
    <div class="flex items-center gap-2 border-b border-hairline bg-raised px-4 py-3">
      {
        agents.map((agent) => (
          <span
            class:list={[
              "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-[0.7rem]",
              agent.active ? "border-hairline-strong bg-panel text-ink" : "border-transparent text-faint",
            ]}
          >
            <svg class="size-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={agent.logo.path} />
            </svg>
            {agent.name}
          </span>
        ))
      }
    </div>

    <div class="space-y-5 p-5 sm:p-8">
      <p
        class="ml-auto w-fit max-w-md rounded-2xl rounded-br-sm border border-hairline bg-raised px-4 py-3 text-body text-ink"
        data-reveal
        style="--d: 400ms"
      >
        Add a pricing page with three tiers and link it in the header.
      </p>

      <p class="flex items-center gap-2 text-label text-faint" data-reveal style="--d: 800ms">
        Thinking
        <span class="flex gap-1" aria-hidden="true">
          <span class="size-1 rounded-full bg-muted-ink motion-safe:animate-dots"></span>
          <span class="size-1 rounded-full bg-muted-ink motion-safe:animate-dots [animation-delay:200ms]"></span>
          <span class="size-1 rounded-full bg-muted-ink motion-safe:animate-dots [animation-delay:400ms]"></span>
        </span>
      </p>

      <ul class="space-y-2 rounded-xl border border-hairline bg-ground p-4 font-mono text-xs">
        <li class="flex gap-3" data-reveal style="--d: 1200ms"><span class="text-live">+</span><span class="text-muted-ink">src/pages/pricing.astro</span></li>
        <li class="flex gap-3" data-reveal style="--d: 1400ms"><span class="text-live">+</span><span class="text-muted-ink">src/content/pricing/en/tiers.md</span></li>
        <li class="flex gap-3" data-reveal style="--d: 1600ms"><span class="text-brand">~</span><span class="text-muted-ink">src/site.ts</span></li>
      </ul>

      <div class="flex items-center gap-2 text-label text-ink" data-reveal style="--d: 1900ms">
        <span class="size-1.5 rounded-full bg-live"></span>
        Draft ready — preview updated, nothing published.
      </div>
    </div>
  </div>
</section>
