---
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";
const choices = [
  {
    name: "WordPress",
    orso: "Your site is already built with Astro, and you want to edit its Markdown content without moving it into WordPress.",
    other: "Choose WordPress for its extensive plugin ecosystem and traditional publishing tools.",
  },
  {
    name: "Wix, Framer, or Webflow",
    orso: "You want a friendly editing workflow while keeping your existing site and deployment outside a visual website platform.",
    other: "Choose a visual builder when you want to design and host the whole site there.",
  },
  {
    name: "Builder.io",
    orso: "You want a focused local workspace and a CMS that writes directly to your Astro content files.",
    other: "Choose Builder.io for a broader visual content and development platform.",
  },
];
---

<Section id="why-orso" rule>
  <SectionHeader label="Why Orso" description="Orso adds an editing workflow to your existing Astro project. Your Markdown, source code, and deployment stay under your control.">
    You keep <span class="text-brand-muted">control.</span>
  </SectionHeader>
  <div class="mt-12 border-b border-section-line sm:mt-16">
    <div class="hidden grid-cols-[1fr_1.4fr_1.4fr] gap-8 border-t border-section-line py-3 text-xs font-medium uppercase tracking-wider text-brand-muted md:grid"><p>Compared with</p><p>Orso is a fit when</p><p>The alternative fits when</p></div>
    {choices.map((choice) => (
      <article class="grid gap-3 border-t border-section-line py-6 md:grid-cols-[1fr_1.4fr_1.4fr] md:gap-8">
        <h3 class="text-base font-medium">{choice.name}</h3>
        <p class="text-sm leading-relaxed text-brand-copy">{choice.orso}</p>
        <p class="text-sm leading-relaxed text-brand-muted">{choice.other}</p>
      </article>
    ))}
  </div>
</Section>
