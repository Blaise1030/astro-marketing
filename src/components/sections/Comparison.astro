---
const choices = [
  {
    name: "WordPress",
    orso: "Your site is already built with Astro, and you want to edit its Markdown content without moving it into WordPress.",
    other: "Choose WordPress for its extensive plugin ecosystem and traditional publishing tools.",
  },
  {
    name: "Wix, Framer, or Webflow",
    orso: "You want a friendly editing workflow while keeping your existing site and deployment outside a visual website platform.",
    other: "Choose a visual builder when you want to design and host the whole site there.",
  },
  {
    name: "Builder.io",
    orso: "You want a focused local workspace and a CMS that writes directly to your Astro content files.",
    other: "Choose Builder.io for a broader visual content and development platform.",
  },
];
---

<section id="why-orso" class="mx-auto max-w-6xl px-6 py-section sm:px-8 sm:py-section-wide">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-brand-accent">Why Orso</p>
    <h2 class="mt-4 text-3xl font-semibold leading-[1.1] tracking-tight sm:text-5xl">You keep <span class="text-brand-accent">control.</span></h2>
    <p class="mx-auto mt-5 max-w-xl leading-relaxed text-brand-muted">Orso adds an editing workflow to your existing Astro project. Your Markdown, source code, and deployment stay under your control.</p>
  </div>
  <div class="mt-10 grid gap-5 sm:mt-12 lg:grid-cols-3">
    {choices.map((choice) => (
      <article class="flex flex-col rounded-panel border border-section-line bg-section-panel p-6 sm:p-7">
        <p class="text-xs font-medium text-brand-muted">Compared with</p>
        <h3 class="mt-2 text-lg font-semibold tracking-tight">{choice.name}</h3>
        <p class="mt-6 text-xs font-semibold text-brand-accent">Orso is a fit when</p>
        <p class="mt-3 flex-1 text-sm leading-relaxed text-brand-copy">{choice.orso}</p>
        <p class="mt-6 border-t border-section-line pt-5 text-xs leading-relaxed text-brand-muted">{choice.other}</p>
      </article>
    ))}
  </div>
</section>
