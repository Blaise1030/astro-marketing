---
import SectionIntro from "@/components/landing/SectionIntro.astro";
import Accent from "@/components/landing/Accent.astro";

const choices = [
  {
    name: "Headless CMS",
    orso: "You want content in the repo where agents can edit it, without making your marketing team learn Git.",
    other: "A headless CMS fits when you need structured content delivered to several websites or apps.",
  },
  {
    name: "WordPress",
    orso: "Your team wants easy editing without a plugin stack to maintain, and your developers want the site in Astro.",
    other: "WordPress fits when you want its plugin ecosystem and a traditional CMS.",
  },
  {
    name: "Wix, Framer, or Webflow",
    orso: "Your developers maintain an Astro site, and your content team needs a simpler way to update it.",
    other: "A visual builder fits when you want design and hosting managed in one place.",
  },
  {
    name: "AI site builders",
    orso: "You want an agent to edit your existing Astro project alongside your developers, using your own agent setup.",
    other: "An AI site builder fits when you want to generate and manage a site within a hosted workspace.",
  },
];
---

<section id="why-orso" class="flex scroll-mt-14 flex-col gap-14 px-6 py-20 sm:px-10">
  <div data-reveal>
    <SectionIntro tag="Compare">
      Find the right <Accent>fit for your team</Accent>.
      <Fragment slot="lead">Orso edits content in your existing Astro project. Here's when that approach fits, and when another tool may suit you better.</Fragment>
    </SectionIntro>
  </div>

  <div data-reveal style="--d: 100ms">
    <div class="hidden grid-cols-[1fr_1.4fr_1.4fr] gap-8 pb-3 font-mono text-[11.5px] text-faint md:grid">
      <p>compared with</p>
      <p>orso fits when</p>
      <p>the other fits when</p>
    </div>
    {
      choices.map((choice) => (
        <article class="grid gap-2 border-t border-dashed border-hairline-strong py-5 md:grid-cols-[1fr_1.4fr_1.4fr] md:gap-8">
          <h3 class="text-[16px] font-medium tracking-[-0.015em]">{choice.name}</h3>
          <p class="text-[14.5px] leading-relaxed text-muted-ink">{choice.orso}</p>
          <p class="text-[14.5px] leading-relaxed text-faint">{choice.other}</p>
        </article>
      ))
    }
  </div>
</section>
