---
import SectionIntro from "@/components/landing/SectionIntro.astro";
import Accent from "@/components/landing/Accent.astro";
import { href } from "@/lib/href";
import Tools from "./Tools.astro";

const choices = [
  { name: "Headless CMS", orso: "Keep content beside your code, ready for your team and agents to edit.", other: "Deliver structured content to several websites or apps." },
  { name: "WordPress", orso: "Give your team an editor while your developers keep building in Astro.", other: "Build around a traditional CMS and its plugin ecosystem." },
  { name: "Visual builders", orso: "Let your team update an Astro site in a repository you own.", other: "Manage visual design and hosting in one platform." },
  { name: "AI site builders", orso: "Bring your agent into a project your whole team can maintain.", other: "Generate and manage a site within a hosted workspace." },
];
---

<section id="why-orso" class="flex scroll-mt-14 flex-col gap-14 px-6 py-20 sm:px-10">
  <div data-reveal>
    <SectionIntro tag="Compare">
      Find the right <Accent>fit for your team</Accent>.
      <Fragment slot="lead">Choose Orso when you want your team and agents working on a site you own. Here’s how that fits alongside other approaches.</Fragment>
    </SectionIntro>
  </div>

  <div data-reveal style="--d: 100ms">
    <div class="hidden grid-cols-[1fr_1.4fr_1.4fr] gap-8 pb-3 font-mono text-[11.5px] text-faint md:grid">
      <p>compared with</p>
      <p>orso fits when</p>
      <p>the other fits when</p>
    </div>
    {
      choices.map((choice) => (
        <article class="grid gap-2 border-t border-dashed border-hairline-strong py-5 md:grid-cols-[1fr_1.4fr_1.4fr] md:gap-8">
          <h3 class="text-[16px] font-medium tracking-[-0.015em]">{choice.name}</h3>
          <p class="text-[14.5px] leading-relaxed text-muted-ink"><span class="font-medium text-ink md:hidden">Orso: </span>{choice.orso}</p>
          <p class="text-[14.5px] leading-relaxed text-muted-ink"><span class="font-medium text-ink md:hidden">Choose {choice.name} to: </span>{choice.other}</p>
        </article>
      ))
    }
  </div>
  <div id="setup" class="flex scroll-mt-20 flex-col gap-6 border-t border-dashed border-hairline-strong pt-8" data-reveal>
    <div class="grid gap-5 md:grid-cols-[1fr_2fr] md:gap-8">
      <h3 class="text-[18px] font-medium tracking-[-0.02em]">Start with Astro. Bring your agent.</h3>
      <div class="flex flex-col gap-4">
        <p class="text-[14.5px] leading-relaxed text-muted-ink">Start from the template or have a developer prepare your existing site. Orso runs locally on macOS and Linux; your team shares the project through GitHub.</p>
        <div class="flex flex-wrap gap-x-6 gap-y-3 text-[13.5px] font-medium text-link"><a class="underline underline-offset-4" href={href("/help/getting-started/")}>Start with the template</a><a class="underline underline-offset-4" href={href("/help/use-orso-with-an-existing-site/")}>Connect your site</a></div>
      </div>
    </div>
    <Tools />
  </div>
</section>
