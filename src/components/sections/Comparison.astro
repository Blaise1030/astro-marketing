---
import SectionIntro from "@/components/landing/SectionIntro.astro";
import Serif from "@/components/landing/Serif.astro";

const choices = [
  {
    name: "WordPress",
    orso: "You already have an Astro site and want to edit Markdown without moving content into WordPress.",
    other: "WordPress fits when you want its plugin ecosystem and a traditional CMS.",
  },
  {
    name: "Wix, Framer, or Webflow",
    orso: "You want a friendly editing workflow while keeping the site, repo, and host under your control.",
    other: "A visual builder fits when you want design and hosting locked into one platform.",
  },
  {
    name: "AI site builders",
    orso: "You already pay for Claude, Cursor or Codex and want them editing a real Astro project you own.",
    other: "An AI site builder fits when you want a hosted canvas and don’t need the source in Git.",
  },
];
---

<section id="why-orso" class="flex scroll-mt-14 flex-col gap-14 px-6 py-20 sm:px-10">
  <div data-reveal>
    <SectionIntro tag="Compare">
      Keep control. <Serif>Skip the migration</Serif>.
      <Fragment slot="lead">Orso is a studio on top of your existing Astro project — not a new place to rebuild the site.</Fragment>
    </SectionIntro>
  </div>

  <div data-reveal style="--d: 100ms">
    <div class="hidden grid-cols-[1fr_1.4fr_1.4fr] gap-8 pb-3 font-mono text-[11.5px] text-faint md:grid">
      <p>compared with</p>
      <p>orso fits when</p>
      <p>the other fits when</p>
    </div>
    {
      choices.map((choice) => (
        <article class="grid gap-2 border-t border-dashed border-hairline-strong py-5 md:grid-cols-[1fr_1.4fr_1.4fr] md:gap-8">
          <h3 class="text-[16px] font-medium tracking-[-0.015em]">{choice.name}</h3>
          <p class="text-[14.5px] leading-relaxed text-muted-ink">{choice.orso}</p>
          <p class="text-[14.5px] leading-relaxed text-faint">{choice.other}</p>
        </article>
      ))
    }
  </div>
</section>
