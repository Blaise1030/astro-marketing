---
import { href } from "../../lib/href";
---

<section class="mx-auto max-w-5xl px-8 py-16 text-center" id="cta">
  <h2 class="mb-4 text-3xl font-bold tracking-tight">Keep your site moving.</h2>
  <p class="mx-auto mb-8 max-w-2xl text-neutral-600 dark:text-neutral-400">Edit the content yourself. Ask for help with everything else. See each change before it goes live.</p>
  <a class="inline-flex min-h-12 items-center justify-center rounded-xl border border-action-edge bg-linear-to-b from-action-top to-action-bottom px-6 py-3 font-semibold text-white shadow-action-raised transition-[transform,box-shadow,filter] duration-150 hover:-translate-y-0.5 hover:brightness-95 active:translate-y-[3px] active:shadow-action-pressed focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-action-bottom motion-reduce:transform-none motion-reduce:transition-none dark:focus-visible:outline-white" href={href("#workflow")}>See the workflow</a>
</section>
