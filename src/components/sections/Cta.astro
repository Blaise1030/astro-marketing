---
import { href } from "../../lib/href";
const { data, id, Content } = Astro.props;
---

<section class="mx-auto max-w-5xl px-8 py-16 text-center" id={id}>
  <h2 class="mb-6 text-3xl font-bold tracking-tight">{data.heading}</h2>
  <div class="prose mx-auto mb-6 dark:prose-invert"><Content /></div>
  <a
    class="inline-block rounded-lg border border-neutral-900 bg-neutral-900 px-5 py-2.5 font-semibold text-white dark:border-white dark:bg-white dark:text-neutral-900"
    href={href(data.cta.href)}>{data.cta.label}</a
  >
</section>
