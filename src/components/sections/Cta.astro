---
import { href } from "../../lib/href";
---

<section class="mx-auto max-w-5xl px-8 py-16 text-center" id="cta">
  <h2 class="mb-4 text-3xl font-bold tracking-tight">Keep your site moving.</h2>
  <p class="mx-auto mb-8 max-w-2xl text-neutral-600 dark:text-neutral-400">Edit the content yourself. Ask for help with everything else. See each change before it goes live.</p>
  <a class="inline-flex min-h-13 items-center justify-center gap-2.5 rounded-2xl border border-brand-blue-border bg-linear-to-b from-brand-blue-top to-brand-blue-bottom px-6 py-3 text-base font-semibold text-white shadow-action transition-colors hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue-bottom" href={href("#workflow")}>
    <svg aria-hidden="true" class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="m8 16-4 4 1-5-3-3 5-1 2-5 3 3" /><path d="M12 15c3.5-1.4 6.8-4.7 8-11-6.3 1.2-9.6 4.5-11 8l3 3Z" /><circle cx="15.5" cy="8.5" r="1" /></svg>
    See the workflow
  </a>
</section>
