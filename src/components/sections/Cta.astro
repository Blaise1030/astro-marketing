---
import Button from "../Button.astro";
---

<section id="cta" class="mx-auto max-w-6xl px-6 pb-section pt-4 sm:px-8 sm:pb-section-wide">
  <div class="hero-ambience rounded-[1.75rem] border border-section-line bg-section-panel px-6 py-14 text-center sm:px-10 sm:py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-brand-accent">Get started</p>
    <h2 class="mt-5 text-4xl font-semibold leading-[1.08] tracking-tight sm:text-5xl">Keep your Astro site<br /><span class="text-brand-accent">up to date.</span></h2>
    <p class="mx-auto mt-5 max-w-lg leading-relaxed text-brand-muted">Edit content, make larger changes with an agent, and publish from one workspace.</p>
    <div class="mt-8 pb-1"><Button href="#workflow">See how Orso works <span aria-hidden="true">↗</span></Button></div>
  </div>
</section>
