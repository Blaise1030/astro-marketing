---
import { href } from "../../lib/href";
---

<section class="mx-auto max-w-5xl px-8 pt-4 pb-20" id="cta">
  <div class="rounded-2xl border border-brand/15 bg-brand/[0.04] px-6 py-14 text-center">
    <h2 class="text-h2">Free, open, and yours — all the way down.</h2>
    <p class="mx-auto mt-3 max-w-xl text-secondary">
      Bring the agent you already pay for. Keep the site you already own.
    </p>
    <p class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        class="inline-block rounded-lg bg-brand px-5 py-3 text-label text-on-brand transition-colors hover:bg-brand-pressed"
        href={href("#how-it-works")}>Start building</a
      >
      <a
        class="inline-block rounded-lg border border-tertiary/60 px-5 py-3 text-label transition-colors hover:border-primary"
        href="https://github.com/Blaise1030/cms">Read the code</a
      >
    </p>
  </div>
</section>
