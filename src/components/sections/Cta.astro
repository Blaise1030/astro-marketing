---
import { buttonVariants } from "@/components/ui/button";
import { href } from "@/lib/href";
import { site } from "@/site";
---

<section class="relative" id="cta">
  <div class="px-6 py-20 sm:px-10 sm:py-28">
    <span class="rounded-sm bg-brand/10 px-1.5 py-0.5 text-[0.7rem] font-medium text-brand">Get started</span>
    <h2 class="mt-6 max-w-4xl text-h1">
      Free, open, and yours — <span class="font-serif font-normal tracking-[-0.02em]">all the way down.</span>
    </h2>
    <p class="mt-6 max-w-md text-body text-muted-ink">
      Bring the agent you already pay for. Keep the Astro site you already own. macOS app first.
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
      <a
        class={buttonVariants({
          size: "lg",
          className: "btn-gloss h-10 rounded-full px-5 text-[0.82rem]",
        })}
        href={href("/download/")}
      >
        Get Orso
      </a>
      <a
        class="group inline-flex items-center gap-2 text-label text-ink/80 transition-colors hover:text-ink"
        href={site.repo}
        rel="noopener"
      >
        Read the code
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>
  </div>
</section>
