---
import { buttonVariants } from "@/components/ui/button";
import { href } from "@/lib/href";
import { site } from "@/site";
---

<section class="relative isolate overflow-hidden border-t border-hairline" id="cta">
  <div class="terrain" aria-hidden="true"></div>
  <div class="shell relative z-10 py-24 text-center sm:py-32">
    <p class="text-eyebrow uppercase text-faint">No lock-in. No seat tax.</p>
    <h2 class="mx-auto mt-5 max-w-2xl text-h2">
      Free, open, and yours.<br />
      <span class="text-muted-ink">All the way down.</span>
    </h2>
    <p class="mx-auto mt-5 max-w-md text-body text-muted-ink">
      Bring the agent you already pay for. Keep the site you already own.
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-x-7 gap-y-4">
      <a
        class={buttonVariants({
          size: "lg",
          className: "btn-gloss h-10 rounded-full px-5 text-[0.82rem]",
        })}
        href={href("#how-it-works")}
      >
        Start building
      </a>
      <a
        class="group inline-flex items-center gap-2 text-label text-ink/80 transition-colors hover:text-ink"
        href={site.repo}
        rel="noopener"
      >
        Read the code
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>
  </div>
</section>
