---
import Button from "../Button.astro";
---

<section class="relative isolate overflow-hidden border-t border-section-line" id="cta">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-radial-[ellipse_at_bottom] from-action-bottom/15 via-section-ink/0 to-section-ink/0"></div>
  <div class="mx-auto max-w-6xl px-6 py-section text-center sm:px-8 sm:py-section-wide">
    <p class="text-xs font-medium uppercase tracking-[0.2em] text-brand-accent">Make your next update</p>
    <h2 class="mx-auto mt-8 max-w-3xl font-editorial text-5xl leading-[1.05] tracking-tight text-balance sm:text-7xl">Keep your<br />site moving.</h2>
    <p class="mx-auto mt-7 max-w-xl text-lg leading-relaxed text-brand-muted">Edit the content yourself. Ask for help with everything else. See each change before it goes live.</p>
    <div class="mt-10 pb-2"><Button href="#workflow">See the workflow <span aria-hidden="true">↗</span></Button></div>
  </div>
</section>
