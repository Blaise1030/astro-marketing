---
import Button from "../Button.astro";
---

<section id="cta" class="mx-auto max-w-6xl px-6 pb-section pt-4 sm:px-8 sm:pb-section-wide">
  <div class="hero-ambience rounded-[1.75rem] border border-section-line bg-section-panel px-6 py-14 text-center sm:px-10 sm:py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-brand-accent">Your next chapter starts with an update</p>
    <h2 class="mt-5 text-4xl font-semibold leading-[1.08] tracking-tight sm:text-6xl">Keep your site<br /><span class="font-editorial font-normal italic text-brand-accent">moving forward.</span></h2>
    <p class="mx-auto mt-5 max-w-lg leading-relaxed text-brand-muted">A new post. A better headline. That change you've been meaning to make. Give it a little room to happen.</p>
    <div class="mt-8 pb-1"><Button href="#workflow">See how Orso works <span aria-hidden="true">↗</span></Button></div>
  </div>
</section>
