---
import { href } from "../../lib/href";
---

<section class="mx-auto max-w-5xl px-8 py-16 text-center" id="cta">
  <h2 class="mb-4 text-3xl font-bold tracking-tight">Keep your site moving.</h2>
  <p class="mx-auto mb-8 max-w-2xl text-neutral-600 dark:text-neutral-400">Edit the content yourself. Ask for help with everything else. See each change before it goes live.</p>
  <a class="inline-block rounded-lg border border-brand-ink bg-brand-ink px-5 py-2.5 font-semibold text-white dark:border-white dark:bg-white dark:text-neutral-900" href={href("#workflow")}>See the workflow</a>
</section>
