---
import { href } from "../../lib/href";
---

<section class="mx-auto max-w-5xl px-8 pt-4 pb-20" id="cta">
  <div class="rounded-2xl border border-tertiary/30 bg-primary/[0.03] px-6 py-14 text-center">
    <h2 class="text-h2">Ready to see it take shape?</h2>
    <p class="mx-auto mt-3 max-w-xl text-secondary">
      Describe your first change and watch Orso build it.
    </p>
    <a
      class="mt-8 inline-block rounded-lg bg-primary px-5 py-3 text-label text-neutral transition-colors hover:bg-primary/80"
      href={href("#how-it-works")}>See how it works</a
    >
  </div>
</section>
