---
import Button from "../Button.astro";
---

<section class="border-t border-section-line" id="cta">
  <div aria-hidden="true" class="frame-hatch h-3 border-b border-section-line"></div>
  <div class="mx-auto grid max-w-6xl gap-8 px-6 py-section sm:px-8 sm:py-section-wide lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-12">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.08em] text-brand-accent">05 / Your next chapter</p>
      <h2 class="mt-5 text-display font-medium text-balance">Keep your<br /><span class="text-brand-accent">site moving.</span></h2>
    </div>
    <div>
      <p class="max-w-xl leading-relaxed text-brand-muted">Edit the content yourself. Ask for help with everything else. See each change before it goes live.</p>
      <div class="mt-6 pb-2"><Button href="#workflow">See the workflow <span aria-hidden="true">↗</span></Button></div>
    </div>
  </div>
</section>
