---
import Accent from "@/components/landing/Accent.astro";
import Logo from "@/components/landing/Logo.astro";
import { buttonVariants } from "@/components/ui/button";
import { href } from "@/lib/href";
import { site } from "@/site";

const btn = "h-9 gap-1.5 rounded-[10px] px-3.5 text-[13.5px] font-medium tracking-[-0.01em]";
// Faint Markdown "paper" behind the closing headline.
const lines = [
  "---", 'title: "Group bookings are here"', "pubDate: 2026-11-15", "categories: [product]", "---", "",
  "# Book the whole team in one link", "", "Share one page.", "Everyone picks a slot.",
  "Fernway handles the rest.", "", "## What's new", "- Group links for up to 20 people", "- Shared calendars",
  "- Reminders by email and SMS", "",
];
---

<section id="get-started" class="relative scroll-mt-14 overflow-hidden px-6 py-28 sm:px-10">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 select-none overflow-hidden whitespace-pre px-10 py-6 font-mono text-[13px] leading-[1.9] text-ink/[0.07] [mask-image:radial-gradient(ellipse_at_center,black_45%,transparent_100%)]"
  >
    {[...lines, ...lines].join("\n")}
  </div>

  <!-- Faint bear walking in from the edge, behind the copy -->
  <Logo class="pointer-events-none absolute -bottom-8 -right-16 h-72 w-auto text-ink/[0.05] sm:-right-10" />

  <div class="relative flex flex-col items-center gap-7 text-center" data-reveal>
    <h2 class="max-w-3xl text-[40px] font-medium leading-[1.04] tracking-[-0.04em] text-balance sm:text-[56px]">
      Let your team run the site. The repo stays <Accent>yours</Accent>.
    </h2>
    <p class="max-w-md pt-2 text-[15.5px] leading-relaxed text-pretty text-muted-ink">
      More people can create, review and publish from one shared project. Free and open source.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a class={buttonVariants({ className: `btn-gloss ${btn}` })} href={href("/download/")}>Download Orso</a>
      <a class={buttonVariants({ variant: "ghost", className: `btn-quiet ${btn}` })} href={site.repo} rel="noopener">Read the code</a>
    </div>
  </div>
</section>
