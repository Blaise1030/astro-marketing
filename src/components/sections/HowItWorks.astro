---
import { Badge } from "@/components/ui/badge";
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";

const steps = [
  {
    title: "Ask, or just edit",
    body: "Developers describe the change and the agent writes code, copy and styles. Everyone else fills in a friendly form. Same site, same repo.",
  },
  {
    title: "Preview it for real",
    body: "Every change is its own draft with a live preview on desktop and mobile, so nothing reaches the live site until it's right.",
  },
  {
    title: "Publish when it's right",
    body: "One click to GitHub Pages. Every earlier version stays in History, so a bad idea costs nothing.",
  },
];
---

<section class="mx-auto max-w-5xl px-8 py-lg" id="how-it-works">
  <div class="max-w-2xl">
    <h2 class="text-h2">From a plain-English request to a live site</h2>
    <p class="mt-3 text-lg text-muted-foreground">
      Three steps. No terminal, and no build pipeline to babysit.
    </p>
  </div>
  <ol class="mt-10 grid gap-md md:grid-cols-3">
    {
      steps.map((step, i) => (
        <li>
          <Card>
            <CardHeader>
              <Badge variant="secondary">{i + 1}</Badge>
              <CardTitle>{step.title}</CardTitle>
              <CardDescription>{step.body}</CardDescription>
            </CardHeader>
          </Card>
        </li>
      ))
    }
  </ol>
</section>
