---
import SectionIntro from "@/components/landing/SectionIntro.astro";
import Accent from "@/components/landing/Accent.astro";
import { href } from "@/lib/href";

// Real Orso screenshots, cropped from 2x captures of a demo project (public/product/workflow/).
const img = (name: string) => href(`/product/workflow/${name}.webp`);
const steps = [
  {
    n: "01",
    title: "Write in the Markdown editor",
    body: "Open a post or help doc and type. The body is plain Markdown, and the title, date, cover image and tags are fields on the right. No frontmatter to get wrong.",
  },
  {
    n: "02",
    title: "Or point at the page in the visual builder",
    body: "Browse the live preview, click the part you want changed and tell the agent what to do. It edits the repo, the preview reloads, and you check it on desktop and mobile.",
  },
  {
    n: "03",
    title: "Publish to main",
    body: "Happy with the draft? Press Publish. Orso merges the change into main, your host rebuilds, and the live site updates. Every earlier version stays in History.",
  },
];
---

<section id="how-it-works" class="flex scroll-mt-14 flex-col gap-14 px-6 py-20 sm:px-10">
  <div data-reveal>
    <SectionIntro tag="Workflow">
      Whoever makes the change, it goes live <Accent>the same way</Accent>.
      <Fragment slot="lead">
        Write it yourself or ask the agent. Either way you get a draft to check, and one button puts it on the live site.
      </Fragment>
    </SectionIntro>
  </div>

  <ol class="flex flex-col">
    {
      steps.map((s, i) => (
        <li
          class:list={[
            "grid gap-8 py-10 lg:grid-cols-[1fr_1.7fr] lg:items-center lg:gap-14",
            i > 0 && "border-t border-dashed border-hairline-strong",
          ]}
          data-reveal
        >
          <div class="flex max-w-md flex-col gap-3">
            <span class="font-mono text-[12px] text-faint">{s.n}</span>
            <h3 class="text-[22px] font-medium tracking-[-0.02em] text-balance">{s.title}</h3>
            <p class="text-[15px] leading-relaxed text-muted-foreground">{s.body}</p>
          </div>

          <div class="frame" style="--d: 120ms">
            <div class="frame-inner dot-well relative p-4 sm:p-6">
              {i === 0 && (
                <div class="float-card overflow-hidden rounded-xl">
                  <img src={img("editor")} width="800" height="607" alt="Orso's Markdown editor: the post body on the left, title, date, cover image and tag fields on the right." loading="lazy" decoding="async" class="block h-auto w-full dark:hidden" />
                  <img src={img("editor-dark")} width="800" height="607" alt="" loading="lazy" decoding="async" class="hidden h-auto w-full dark:block" />
                </div>
              )}
              {i === 1 && (
                <div class="float-card overflow-hidden rounded-xl">
                  <img src={img("builder")} width="900" height="500" alt="Orso's visual builder: the homepage headline is selected in the live preview and the agent explains the change in the chat beside it." loading="lazy" decoding="async" class="block h-auto w-full" />
                </div>
              )}
              {i === 2 && (
                <div class="relative">
                  <div class="float-card overflow-hidden rounded-xl">
                    <img src={img("history")} width="600" height="408" alt="Orso's History on main, with the merged change at the top marked Current." loading="lazy" decoding="async" class="block h-auto w-full" />
                  </div>
                  <div class="absolute -bottom-2 right-2 flex flex-col items-end gap-3 sm:-bottom-3 sm:right-4">
                    <div class="float-card overflow-hidden rounded-xl">
                      <img src={href("/product/features/publish-a.webp")} width="223" height="45" alt="The Publish button." loading="lazy" decoding="async" class="block h-auto w-[160px] sm:w-[223px] dark:hidden" />
                      <img src={href("/product/features/publish-a-dark.webp")} width="223" height="45" alt="" loading="lazy" decoding="async" class="hidden h-auto w-[160px] sm:w-[223px] dark:block" />
                    </div>
                    <div class="float-card overflow-hidden rounded-xl">
                      <img src={href("/product/features/publish-b.webp")} width="373" height="70" alt="Toast: Published. Waiting for the site to update." loading="lazy" decoding="async" class="block h-auto w-[240px] sm:w-[373px] dark:hidden" />
                      <img src={href("/product/features/publish-b-dark.webp")} width="373" height="70" alt="" loading="lazy" decoding="async" class="hidden h-auto w-[240px] sm:w-[373px] dark:block" />
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>
