---
import { href } from "../../lib/href";
const { data, id, Content } = Astro.props;
---

<section class="mx-auto max-w-5xl px-8 py-16" id={id}>
  <h2 class="mb-6 text-3xl font-bold tracking-tight">{data.heading}</h2>
  <div class="prose mb-6 max-w-none dark:prose-invert"><Content /></div>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-6">
    {data.plans.map((p) => (
      <div class:list={["flex flex-col rounded-xl border p-5", p.highlighted ? "border-current" : "border-neutral-400/30"]}>
        <h3 class="text-lg font-semibold">{p.name}</h3>
        <p class="mt-2"><strong class="text-3xl font-bold">{p.price}</strong> {p.period}</p>
        <ul class="my-4 flex-1 list-disc space-y-1 pl-5">{p.features.map((f) => <li>{f}</li>)}</ul>
        <a class="inline-block rounded-lg border border-current px-5 py-2.5 text-center font-semibold" href={href(p.cta.href)}>
          {p.cta.label}
        </a>
      </div>
    ))}
  </div>
</section>
