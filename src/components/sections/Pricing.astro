---
import { href } from "../../lib/href";

const plans = [
  {
    name: "Starter",
    price: "$0",
    period: "forever",
    features: ["One site", "Community support"],
    cta: { label: "Start free", href: "#" },
    highlighted: false,
  },
  {
    name: "Pro",
    price: "$19",
    period: "per month",
    features: ["Unlimited sites", "Custom domain", "Priority support"],
    cta: { label: "Go Pro", href: "#" },
    highlighted: true,
  },
];
---

<section class="mx-auto max-w-5xl px-8 py-lg" id="pricing">
  <h2 class="mb-md text-h2 tracking-tight">Simple, honest pricing</h2>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-md">
    {plans.map((p) => (
      <div
        class:list={[
          "flex flex-col rounded-lg border p-5",
          p.highlighted ? "border-accent ring-1 ring-accent" : "border-tertiary dark:border-neutral-800",
        ]}
      >
        <h3 class="text-lg font-semibold">{p.name}</h3>
        <p class="mt-2 text-secondary dark:text-neutral-400"><strong class="text-3xl font-semibold text-primary dark:text-neutral-100">{p.price}</strong> {p.period}</p>
        <ul class="my-4 flex-1 list-disc space-y-1 pl-5 text-body-sm">{p.features.map((f) => <li>{f}</li>)}</ul>
        <a
          class:list={[
            "inline-block rounded-md px-4 py-2 text-center text-label focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
            p.highlighted
              ? "bg-accent text-white hover:bg-accent/90"
              : "border border-tertiary bg-neutral text-primary hover:bg-surface dark:border-neutral-700 dark:bg-transparent dark:text-neutral-100 dark:hover:bg-neutral-900",
          ]}
          href={href(p.cta.href)}
        >
          {p.cta.label}
        </a>
      </div>
    ))}
  </div>
</section>
