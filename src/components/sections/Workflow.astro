---

<section class="border-t border-section-line bg-section-ink text-neutral-100" id="workflow">
  <div class="mx-auto max-w-6xl px-6 py-section sm:px-8 sm:py-section-wide">
    <p class="mb-6 font-mono text-xs uppercase tracking-[0.08em] text-brand-accent">02 / One connected workflow</p>
    <div class="grid gap-x-12 gap-y-1 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
    <h2 class="max-w-4xl text-3xl font-medium leading-[1.12] tracking-tight text-balance sm:text-4xl lg:text-5xl">
      From the first edit<br />
      <span class="text-brand-muted">to the live site.</span>
    </h2>
    <p class="mt-7 max-w-2xl text-base leading-relaxed text-brand-muted lg:mt-0">Content, agent work, preview, and publishing stay connected to the same project.</p>
    </div>
    <div class="mt-10 grid gap-px border border-section-line bg-section-line sm:mt-12 sm:grid-cols-2 lg:grid-cols-3">
      {capabilities.map((capability) => (
        <article class="bg-section-ink p-6 sm:p-8">
          <span class="inline-flex size-12 items-center justify-center rounded-md border border-section-line bg-section-panel"><svg aria-hidden="true" class="size-6 text-brand-accent" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24"><path d={capability.icon} /></svg></span>
          <h3 class="mt-6 text-xl font-semibold tracking-tight">{capability.title}</h3>
          <p class="mt-3 max-w-sm leading-relaxed text-brand-muted">{capability.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
