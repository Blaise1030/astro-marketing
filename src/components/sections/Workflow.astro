---
const capabilities = [
  {
    title: "Edit structured content",
    description: "Update the body and fields of supported Astro content collections in a dedicated editor.",
    icon: "M5 3h10l4 4v14H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm10 0v5h5M7 13h10M7 17h10",
  },
  {
    title: "Ask an agent",
    description: "Describe the copy, design, layout, or code change you need beyond the CMS.",
    icon: "m12 2 2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5L12 2Z",
  },
  {
    title: "Preview as you work",
    description: "See the site respond to edits in a local preview before anyone else sees them.",
    icon: "M2 12s3.7-7 10-7 10 7 10 7-3.7 7-10 7-10-7-10-7Zm10-3a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z",
  },
  {
    title: "Revisit changes",
    description: "Use history to inspect earlier work and restore a previous checkpoint.",
    icon: "M12 6v6l4 2M3 12a9 9 0 1 0 3-6.7M3 4v4h4",
  },
  {
    title: "Share for feedback",
    description: "Share a GitHub-backed change and its preview link when the site's deployment is configured.",
    icon: "M8 12h8M16 12l-3-3m3 3-3 3M4 4h16v16H4z",
  },
  {
    title: "Publish through GitHub",
    description: "Move the approved change through the repository workflow that already deploys your site.",
    icon: "M12 16V3m0 0L7 8m5-5 5 5M4 16v4h16v-4",
  },
];
---

<section class="bg-section-ink text-white" id="workflow">
  <div class="mx-auto max-w-6xl border-t border-section-line px-8 py-24 sm:py-32">
    <p class="mb-6 text-sm font-semibold uppercase tracking-[0.2em] text-neutral-400">One connected workflow</p>
    <h2 class="max-w-5xl text-5xl font-light leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
      From the first edit<br />
      <span class="text-neutral-400">to the live site.</span>
    </h2>
    <p class="mt-8 max-w-3xl text-lg leading-relaxed text-neutral-400">Content, agent work, preview, and publishing stay connected to the same project.</p>
    <div class="mt-16 grid gap-x-12 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
      {capabilities.map((capability) => (
        <article>
          <svg aria-hidden="true" class="size-7 text-neutral-100" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24"><path d={capability.icon} /></svg>
          <h3 class="mt-7 text-xl font-semibold tracking-tight">{capability.title}</h3>
          <p class="mt-3 max-w-sm leading-relaxed text-neutral-400">{capability.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
