---
import { toolLogos } from "@/lib/tool-logos";

const tools = [
  { name: "Astro", logo: toolLogos.astro },
  { name: "Markdown", logo: toolLogos.markdown },
  { name: "GitHub", logo: toolLogos.github },
  { name: "Claude", logo: toolLogos.claude },
  { name: "Cursor", logo: toolLogos.cursor },
  { name: "Codex", logo: toolLogos.codex },
];
---

<section id="logos" class="flex scroll-mt-14 flex-col gap-8 px-6 py-12 sm:px-10" aria-label="Works with">
  <p class="text-[13.5px] text-muted-ink">Works with the stack and agents you already have</p>
  <div class="grid grid-cols-3 items-center gap-y-8 md:flex md:justify-between">
    {
      tools.map((tool) => (
        <span class="flex justify-center">
          <span class="inline-flex h-7 items-center gap-2 whitespace-nowrap text-faint transition-colors duration-150 hover:text-ink">
            <svg class="size-[18px] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={tool.logo.path} />
            </svg>
            <span class="text-[18px] font-semibold leading-none tracking-[-0.03em]">{tool.name}</span>
          </span>
        </span>
      ))
    }
  </div>
</section>
