---
import { toolLogos } from "@/lib/tool-logos";

const tools = [
  { name: "Astro", logos: [toolLogos.astro] },
  { name: "Markdown", logos: [toolLogos.markdown] },
  { name: "GitHub", logos: [toolLogos.github] },
  { name: "Claude", logos: [toolLogos.claude] },
  { name: "Cursor", logos: [toolLogos.cursor] },
  { name: "Codex", logos: [toolLogos.codex] },
];
---

<section class="pt-8" aria-label="Works with">
  <p class="px-6 text-[0.8rem] text-muted-ink sm:px-10">Built on the stack you already trust.</p>
  <div class="mt-6 grid grid-cols-3 border-t border-hairline sm:grid-cols-6">
    {
      tools.map((tool, i) => (
        <div
          class:list={[
            "group flex h-20 items-center justify-center gap-2 border-hairline text-faint transition-colors hover:text-ink",
            i % 3 !== 2 && "border-r",
            i < 3 && "border-b sm:border-b-0",
            "sm:[&:not(:last-child)]:border-r",
          ]}
        >
          {tool.logos.map((logo) => (
            <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={logo.path} />
            </svg>
          ))}
          <span class="text-[0.85rem] font-medium tracking-tight">{tool.name}</span>
        </div>
      ))
    }
  </div>
</section>
