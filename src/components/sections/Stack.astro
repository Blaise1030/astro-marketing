---
import { Badge } from "@/components/ui/badge";
import { Card, CardContent, CardHeader } from "@/components/ui/card";

const keep = ["Your AI agent", "Astro", "Markdown", "Git + GitHub", "GitHub Pages"];
const drop = ["AI site builders", "Hosted CMS", "Per-seat page builders"];
---

<section class="mx-auto max-w-5xl px-8 py-14" id="stack">
  <p class="text-center text-xs font-semibold uppercase tracking-widest text-muted-foreground">
    One app instead of three subscriptions
  </p>
  <p class="mx-auto mt-3 max-w-xl text-center text-lg text-muted-foreground">
    Bring the agent you already pay for. Drop the rest of the stack.
  </p>
  <div class="mt-md grid gap-md sm:grid-cols-2">
    <Card>
      <CardHeader>
        <p class="text-label text-muted-foreground">You already have</p>
      </CardHeader>
      <CardContent>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            keep.map((name) => (
              <li>
                <Badge variant="outline">{name}</Badge>
              </li>
            ))
          }
        </ul>
      </CardContent>
    </Card>
    <Card>
      <CardHeader>
        <p class="text-label text-muted-foreground">You stop paying for</p>
      </CardHeader>
      <CardContent>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            drop.map((name) => (
              <li>
                <Badge variant="outline" className="line-through">
                  {name}
                </Badge>
              </li>
            ))
          }
        </ul>
      </CardContent>
    </Card>
  </div>
</section>
