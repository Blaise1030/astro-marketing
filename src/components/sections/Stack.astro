---
import SectionIntro from "@/components/landing/SectionIntro.astro";
import Accent from "@/components/landing/Accent.astro";
import ProductImage from "@/components/landing/ProductImage.astro";
const examples = [
  { title: "Build the campaign page", ask: "Build a landing page for group bookings with our usual hero and FAQ.", result: "A new page using the components already in your project.", image: "ask", width: 872, height: 430, alt: "Ask an agent for a change in Orso" },
  { title: "Turn questions into articles", ask: "Turn this week's top customer questions into help articles.", result: "Help articles you can refine in familiar content fields.", image: "write", width: 574, height: 400, alt: "Edit article details and content in Orso" },
  { title: "Make the change everywhere", ask: "Link every post that mentions previews to the new guide.", result: "A batch of edits to check together before publishing.", image: "preview", width: 920, height: 396, alt: "Preview a draft before publishing in Orso" },
];
---
<section id="handoff" class="flex scroll-mt-14 flex-col gap-14 px-6 py-20 sm:px-10">
  <div data-reveal>
    <SectionIntro tag="Possibilities">
      Take the idea <Accent>further yourself</Accent>.
      <Fragment slot="lead">Update the words in a form. Ask an agent when the idea needs a new page, a different layout or changes across the site.</Fragment>
    </SectionIntro>
  </div>
  <div class="grid gap-10 lg:grid-cols-3 lg:gap-8">
    {examples.map((example) => (
      <article class="flex min-w-0 flex-col gap-5" data-reveal>
        <div class="frame"><div class="frame-inner dot-well flex h-52 items-center overflow-hidden p-4">
          <div class="float-card w-full overflow-hidden rounded-xl"><ProductImage name={example.image} width={example.width} height={example.height} alt={example.alt} /></div>
        </div></div>
        <h3 class="text-[19px] font-medium tracking-[-0.02em]">{example.title}</h3>
        <p class="text-[14.5px] leading-relaxed text-ink">“{example.ask}”</p>
        <p class="text-[14px] leading-relaxed text-muted-ink">{example.result}</p>
        <a href="#how-it-works" class="mt-auto text-[13px] font-medium text-link underline underline-offset-4">See how to preview and publish</a>
      </article>
    ))}
  </div>
</section>
