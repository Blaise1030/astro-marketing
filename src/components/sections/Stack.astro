---
const keep = ["Your AI agent", "Astro", "Markdown", "Git + GitHub", "GitHub Pages"];
const drop = ["AI site builders", "Hosted CMS", "Per-seat page builders"];
---

<section class="shell py-20 sm:py-section" id="stack">
  <div class="grid gap-5 lg:grid-cols-[1fr_1fr] lg:items-end">
    <h2 class="max-w-xl text-h2">
      One app.<br />
      <span class="text-muted-ink">Not three subscriptions.</span>
    </h2>
    <p class="max-w-md text-body text-muted-ink lg:justify-self-end">
      Bring the agent you already pay for. Drop the rest of the stack — no new account, just the repo you already own.
    </p>
  </div>

  <div class="mt-12 grid gap-px overflow-hidden rounded-xl border border-hairline bg-hairline sm:grid-cols-2">
    <div class="bg-ground p-6 sm:p-8">
      <div class="flex items-center justify-between">
        <p class="text-eyebrow uppercase text-faint">You already have</p>
        <span class="size-1.5 rounded-full bg-live" aria-hidden="true"></span>
      </div>
      <ul class="mt-5">
        {
          keep.map((name) => (
            <li class="flex items-center gap-3 border-t border-hairline py-3 last:border-b">
              <span class="font-mono text-[11px] text-live" aria-hidden="true">
                ✓
              </span>
              <span class="text-label text-ink">{name}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-5 text-label text-faint">Already paid for, already in your repo.</p>
    </div>

    <div class="bg-ground p-6 sm:p-8">
      <div class="flex items-center justify-between">
        <p class="text-eyebrow uppercase text-faint">You stop paying for</p>
        <span class="size-1.5 rounded-full bg-hairline-strong" aria-hidden="true"></span>
      </div>
      <ul class="mt-5">
        {
          drop.map((name) => (
            <li class="flex items-center gap-3 border-t border-hairline py-3 last:border-b">
              <span class="font-mono text-[11px] text-faint" aria-hidden="true">
                −
              </span>
              <span class="text-label text-faint line-through decoration-faint/60">{name}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-5 text-label text-faint">Cancel whenever. Nothing here stops working.</p>
    </div>
  </div>
</section>
