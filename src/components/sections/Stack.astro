---
const stack = ["Astro", "Tailwind CSS", "Markdown", "GitHub", "Static hosting"];
---

<section class="mx-auto max-w-5xl px-8 py-14" id="stack">
  <p class="text-center text-xs font-semibold uppercase tracking-widest text-secondary">
    Built on tools that outlast trends
  </p>
  <div class="mt-md grid grid-cols-2 gap-3 sm:grid-cols-5">
    {
      stack.map((name) => (
        <div class="rounded-lg border border-tertiary/30 px-4 py-3 text-center text-label text-secondary">
          {name}
        </div>
      ))
    }
  </div>
</section>
