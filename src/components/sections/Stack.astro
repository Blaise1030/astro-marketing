---
import SectionIntro from "@/components/landing/SectionIntro.astro";
import Accent from "@/components/landing/Accent.astro";

const before = [
  "“Can someone change this headline?” — a ticket, then a wait",
  "A developer has to run the preview before anyone sees it",
  "A second login for a CMS nobody else uses",
  "Content locked in a CMS the agent can't see",
];
const badge = "grid size-5 place-items-center rounded-full text-white";
---

<section id="handoff" class="flex scroll-mt-14 flex-col gap-14 px-6 py-20 sm:px-10">
  <div data-reveal>
    <SectionIntro tag="Repo">
      A headline change shouldn't need a <Accent>ticket</Accent>.
      <Fragment slot="lead">
        Your teammate makes the edit, or asks the agent to. Either way it lands as Markdown in the repo, right where
        your developers and their agents work.
      </Fragment>
    </SectionIntro>
  </div>

  <div class="grid md:grid-cols-2" data-reveal style="--d: 100ms">
    <div class="flex flex-col gap-5 pb-10 md:pb-0 md:pr-10">
      <span class="flex items-center gap-2.5">
        <span class:list={[badge, "bg-ink/20 shadow-[0_0_0_3px_color-mix(in_oklab,var(--palette-ink)_4%,transparent)]"]}>
          <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </span>
        <span class="font-mono text-[12px] text-muted-ink">before</span>
      </span>
      <ul class="flex flex-col">
        {
          before.map((item, i) => (
            <li
              class:list={[
                "py-3.5 text-[15.5px] font-medium tracking-[-0.015em] text-faint line-through decoration-ink/20",
                i > 0 && "border-t border-dashed border-hairline-strong",
              ]}
            >
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex flex-col gap-5 border-t border-dashed border-hairline-strong pt-10 md:border-l md:border-t-0 md:pl-10 md:pt-0">
      <span class="flex items-center gap-2.5">
        <span class:list={[badge, "bg-brand shadow-[0_0_0_3px_rgb(47_108_236/0.14)]"]}>
          <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>
        </span>
        <span class="font-mono text-[12px] text-muted-ink">with orso</span>
      </span>
      <div class="frame">
        <div class="frame-inner">
          <div class="flex h-10 items-center justify-between border-b border-hairline px-4">
            <span class="font-mono text-[11.5px] text-muted-ink">src/content/blog/en/launch.md</span>
            <span class="rounded-md px-1.5 py-0.5 font-mono text-[10.5px] text-faint shadow-[0_0_0_1px_color-mix(in_oklab,var(--palette-ink)_8%,transparent)]">copy</span>
          </div>
          <pre class="overflow-x-auto p-4 font-mono text-[12.5px] leading-[1.75] text-muted-ink"><code><span class="text-faint">---</span>
<span class="text-brand-ink">title</span>: <span class="text-ink">"Introducing Orso 1.0"</span>
<span class="text-brand-ink">pubDate</span>: <span class="text-ink">2026-11-15</span>
<span class="text-brand-ink">categories</span>: [<span class="text-ink">product</span>]
<span class="text-faint">---</span>

<span class="text-ink">A studio for the site you already own.</span>
Edit it here, or ask your agent.</code></pre>
        </div>
      </div>
    </div>
  </div>
</section>
