---
import { href } from "../lib/href";
import { slugify } from "../lib/help";
interface Props { sections: string[]; active?: string }
const { sections, active } = Astro.props;
const filterClass = "uppercase tracking-wide border-b border-transparent pb-0.5 text-xs font-medium text-brand-muted transition-colors hover:text-brand-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent aria-[current=page]:border-brand-foreground aria-[current=page]:text-brand-foreground";
---
<div class="mb-12 flex flex-wrap items-center gap-x-10 gap-y-4">
  <p class="text-xs font-semibold uppercase tracking-wide">/// {active ? active : "All docs"}</p>
  <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Help sections">
    <a class={filterClass} href={href("/help/")} aria-current={active ? undefined : "page"}>All</a>
    {sections.map((section) => <a class={filterClass} href={href(`/help/section/${slugify(section)}/`)} aria-current={section === active ? "page" : undefined}>{section}</a>)}
  </nav>
</div>
