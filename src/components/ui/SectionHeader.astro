---
interface Props {
  /** Small marker above the heading, e.g. "How it works". */
  label?: string;
  description?: string;
  align?: "left" | "center";
  tone?: "default" | "inverse";
  /** Render the heading as `h1` for the first heading on a page. */
  level?: "h1" | "h2";
  class?: string;
}
const { label, description, align = "left", tone = "default", level = "h2", class: className } = Astro.props;
const Heading = level;
const inverse = tone === "inverse";
---

<div class:list={["flex flex-col", align === "center" ? "items-center text-center" : "items-start", className]}>
  {label && (
    <p class:list={["flex items-center gap-2 text-xs font-medium uppercase tracking-wider", inverse ? "text-inverse-foreground/60" : "text-brand-muted"]}>
      <span aria-hidden="true" class:list={["tracking-normal", inverse ? "text-action-top" : "text-brand-accent"]}>///</span>{label}
    </p>
  )}
  <Heading class:list={["max-w-2xl text-balance text-3xl font-normal tracking-tight sm:text-4xl lg:text-5xl", label && "mt-5", inverse ? "text-inverse-foreground" : "text-brand-foreground"]}><slot /></Heading>
  {description && <p class:list={["mt-5 max-w-xl text-pretty leading-relaxed", inverse ? "text-inverse-foreground/70" : "text-brand-muted"]}>{description}</p>}
  <div class="empty:hidden mt-8 flex flex-wrap gap-3"><slot name="actions" /></div>
</div>
