---
import { href } from "../lib/href";
import { slugify } from "../lib/blog";
interface Props { categories: string[]; active?: string }
const { categories, active } = Astro.props;
const item = "relative h-7 whitespace-nowrap rounded-[8px] px-3 text-[13px] font-medium capitalize leading-7 text-muted-ink transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand aria-[current=page]:bg-panel aria-[current=page]:text-ink aria-[current=page]:shadow-[0_0_0_1px_color-mix(in_oklab,var(--palette-ink)_6%,transparent),0_1px_2px_rgb(0_0_0/0.06)]";
const dot = "absolute top-1/2 z-10 size-2 -translate-y-1/2 rounded-full bg-panel shadow-sm shadow-black/10 ring-1 ring-ink/10";
---
<!--
  Sticky under the header. The outer bar is transparent so the side rails stay
  visible; only the strip between the rails gets the frosted ground. It carries
  its own bottom hairline (with rail dots) so it keeps an edge while stuck.
-->
<div class="sticky top-14 z-40">
  <div class="mx-2 flex flex-wrap items-center gap-x-6 gap-y-3 bg-ground/85 px-4 py-4 backdrop-blur-md sm:px-8">
    <p class="font-mono text-[12px] text-faint">{active ? `category / ${active.toLowerCase()}` : "all posts"}</p>
    <nav class="flex max-w-full gap-0.5 overflow-x-auto rounded-[10px] bg-ink/[0.04] p-0.5" aria-label="Blog categories">
      <a class={item} href={href("/blog/")} aria-current={active ? undefined : "page"}>All</a>
      {categories.map((category) => <a class={item} href={href(`/blog/category/${slugify(category)}/`)} aria-current={category === active ? "page" : undefined}>{category}</a>)}
    </nav>
  </div>
  <div aria-hidden="true" class="relative h-px bg-hairline">
    <span class:list={[dot, "left-1 -translate-x-1/2"]}></span>
    <span class:list={[dot, "right-1 translate-x-1/2"]}></span>
  </div>
</div>
