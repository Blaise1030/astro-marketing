---
// A Figma-style selection box: brand outline, four corner handles and a mono label.
// Pass `label`, or fill the `label` slot (e.g. with an island).
interface Props {
  label?: string;
  position?: "top" | "bottom";
  class?: string;
}
const { label, position = "bottom", class: className } = Astro.props;
const handle = "absolute size-[7px] border-[1.5px] border-brand bg-panel";
---

<span
  class:list={[
    "relative -mx-[0.06em] inline-block bg-brand/[0.07] px-[0.06em] outline-[1.5px] outline-brand outline-solid",
    className,
  ]}
>
  <slot />
  <span aria-hidden="true" class:list={[handle, "-left-[4px] -top-[4px]"]}></span>
  <span aria-hidden="true" class:list={[handle, "-right-[4px] -top-[4px]"]}></span>
  <span aria-hidden="true" class:list={[handle, "-bottom-[4px] -left-[4px]"]}></span>
  <span aria-hidden="true" class:list={[handle, "-bottom-[4px] -right-[4px]"]}></span>
  <span
    aria-hidden="true"
    class:list={[
      "absolute left-1/2 z-10 inline-flex -translate-x-1/2 items-center whitespace-nowrap rounded-[4px] bg-brand px-1.5 py-0.5 font-mono text-[11px] font-medium leading-4 tracking-normal text-white",
      position === "bottom" ? "top-[calc(100%+8px)]" : "bottom-[calc(100%+8px)]",
    ]}
  >
    {label}<slot name="label" />
  </span>
</span>
