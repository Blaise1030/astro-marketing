---
import Tag from "./Tag.astro";

interface Props {
  tag: string;
}
const { tag } = Astro.props;
---

<div class="flex flex-col gap-5">
  <Tag>{tag}</Tag>
  <h2 class="max-w-2xl text-h2 font-medium text-balance"><slot /></h2>
  {
    Astro.slots.has("lead") && (
      <p class="max-w-xl text-[15.5px] leading-relaxed text-pretty text-muted-ink">
        <slot name="lead" />
      </p>
    )
  }
</div>
