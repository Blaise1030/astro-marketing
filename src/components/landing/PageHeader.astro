---
// Opening block for Blog and Help pages: back link, tag, h1, lead, optional extras.
import { href } from "@/lib/href";
import Tag from "./Tag.astro";

interface Props {
  tag: string;
  back?: { href: string; label: string };
  lead?: string;
}
const { tag, back, lead } = Astro.props;
---

<header class="flex flex-col gap-6 px-6 pb-14 pt-16 sm:px-10 sm:pt-20">
  {
    back && (
      <a
        class="group w-fit font-mono text-[12px] text-faint transition-colors hover:text-ink"
        href={href(back.href)}
        data-pagefind-ignore
      >
        <span aria-hidden="true" class="inline-block transition-transform group-hover:-translate-x-0.5">←</span> {back.label}
      </a>
    )
  }
  <div class="flex flex-wrap items-center gap-3">
    <Tag>{tag}</Tag>
    <slot name="meta" />
  </div>
  <h1 class="max-w-3xl text-[40px] font-medium leading-[1.05] tracking-[-0.04em] text-balance sm:text-[52px]"><slot /></h1>
  {lead && <p class="max-w-2xl text-[16.5px] leading-relaxed text-pretty text-muted-ink">{lead}</p>}
  <slot name="after" />
</header>
