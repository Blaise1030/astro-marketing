---
import { href } from "@/lib/href";
interface Props { name: string; width: number; height: number; alt: string; }
const { name, width, height, alt } = Astro.props;
---
<div>
  <img src={href(`/product/features/${name}.webp`)} width={width} height={height} alt={alt} loading="lazy" decoding="async" class="block h-auto w-full dark:hidden" />
  <img src={href(`/product/features/${name}-dark.webp`)} width={width} height={height} alt={alt} loading="lazy" decoding="async" class="hidden h-auto w-full dark:block" />
</div>
