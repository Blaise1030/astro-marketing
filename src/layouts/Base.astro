---
import { href } from "../lib/href";
import { site } from "../site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="en" class="scheme-light-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-neutral font-sans text-primary antialiased">
    <header class="border-b border-tertiary/30">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-md px-8 py-6">
        <a class="text-lg font-bold tracking-tight" href={base}>{site.name}</a>
        <nav class="flex flex-wrap items-center gap-4 text-label text-secondary sm:gap-md">
          {site.nav.map((l) => (
            <a class="transition-colors hover:text-primary" href={href(l.href)}>{l.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="border-t border-tertiary/30">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-md px-8 py-10 text-label text-secondary">
        <p>{site.footer.text}</p>
        <nav class="flex flex-wrap gap-md">
          {site.footer.links.map((l) => (
            <a class="transition-colors hover:text-primary" href={href(l.href)}>{l.label}</a>
          ))}
          {site.socials.map((s) => (
            <a class="transition-colors hover:text-primary" href={s.href} rel="noopener">{s.label}</a>
          ))}
        </nav>
      </div>
    </footer>
  </body>
</html>
