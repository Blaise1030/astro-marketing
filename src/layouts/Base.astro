---
import { buttonVariants } from "@/components/ui/button";
import { Separator } from "@/components/ui/separator";
import { href } from "@/lib/href";
import { site } from "@/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f5" />
    <script is:inline>
      // Pick the theme before first paint: stored choice first, system second.
      (() => {
        const root = document.documentElement;
        let theme = null;
        try {
          theme = localStorage.getItem("orso-theme");
        } catch {}
        if (theme !== "light" && theme !== "dark") {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        const dark = theme === "dark";
        root.classList.toggle("dark", dark);
        root.style.colorScheme = theme;
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", dark ? "#080808" : "#f7f7f5");
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-background font-sans text-foreground antialiased">
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-brand focus:px-4 focus:py-2 focus:text-label focus:text-on-brand"
      href="#main"
    >
      Skip to content
    </a>
    <header class="sticky top-0 z-50 border-b border-hairline bg-ground/80 backdrop-blur-xl">
      <div class="shell relative flex h-16 items-center justify-between gap-4">
        <a class="shrink-0 text-[17px] font-semibold tracking-tight" href={base}>
          orso<sup class="ml-0.5 align-super text-[9px] font-normal text-muted-ink">®</sup>
        </a>

        <nav
          class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-1 lg:flex"
          aria-label="Main"
        >
          {
            site.nav.map((l) => (
              <a
                class="rounded-md px-3 py-2 text-label text-muted-ink transition-colors hover:text-ink"
                href={href(l.href)}
              >
                {l.label}
              </a>
            ))
          }
        </nav>

        <div class="ml-auto flex items-center gap-2">
          <a
            class="hidden rounded-md px-3 py-2 text-label text-muted-ink transition-colors hover:text-ink sm:inline-flex"
            href={site.repo}
            rel="noopener"
          >
            GitHub
          </a>
          <a
            class={buttonVariants({ size: "sm", className: "btn-gloss h-8 rounded-full px-3.5 text-[0.78rem]" })}
            href={href("#how-it-works")}
          >
            Start building
          </a>

          <button
            type="button"
            id="theme-toggle"
            class="flex size-8 shrink-0 items-center justify-center rounded-full border border-hairline text-muted-ink transition-colors hover:border-hairline-strong hover:text-ink"
            aria-label="Switch to light theme"
          >
            <svg
              class="hidden size-4 dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4.25"></circle>
              <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4l1.4-1.4M18 6l1.4-1.4"></path>
            </svg>
            <svg
              class="size-4 dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11Z"></path>
            </svg>
          </button>

          <details class="relative lg:hidden">
            <summary
              class="flex size-8 cursor-pointer list-none items-center justify-center rounded-full border border-hairline text-muted-ink transition-colors hover:text-ink [&::-webkit-details-marker]:hidden"
              aria-label="Open menu"
            >
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                <path d="M2 4h11M2 7.5h11M2 11h11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              </svg>
            </summary>
            <nav
              class="absolute right-0 top-[calc(100%+0.75rem)] w-56 rounded-xl border border-hairline bg-panel p-2 shadow-2xl shadow-black/10 dark:shadow-black/60"
              aria-label="Mobile"
            >
              {
                site.nav.map((l) => (
                  <a
                    class="block rounded-md px-3 py-2.5 text-label text-muted-ink transition-colors hover:bg-raised hover:text-ink"
                    href={href(l.href)}
                  >
                    {l.label}
                  </a>
                ))
              }
              <a
                class="mt-1 block rounded-md border-t border-hairline px-3 py-2.5 text-label text-muted-ink transition-colors hover:bg-raised hover:text-ink"
                href={site.repo}
                rel="noopener"
              >
                GitHub
              </a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="border-t border-hairline">
      <div class="shell py-16">
        <div class="grid gap-12 lg:grid-cols-[1.1fr_1.6fr]">
          <div>
            <a class="text-3xl font-semibold tracking-tight" href={base}>
              orso<sup class="ml-1 align-super text-xs font-normal text-muted-ink">®</sup>
            </a>
            <p class="mt-5 max-w-xs text-body text-muted-ink">{site.footer.tagline}</p>
          </div>
          <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
            {
              site.footer.columns.map((column) => (
                <div>
                  <p class="text-eyebrow uppercase text-faint">{column.title}</p>
                  <ul class="mt-4 space-y-2.5">
                    {column.links.map((link) => (
                      <li>
                        <a
                          class="text-label text-muted-ink transition-colors hover:text-ink"
                          href={href(link.href)}
                          rel={"external" in link ? "noopener" : undefined}
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>

        <Separator className="mt-16" />

        <div class="flex flex-wrap items-center justify-between gap-4 pt-6 text-label text-faint">
          <p>{site.footer.text}</p>
          <nav class="flex flex-wrap items-center gap-5" aria-label="Footer">
            {site.footer.links.map((l) => (
              <a class="transition-colors hover:text-ink" href={href(l.href)}>{l.label}</a>
            ))}
            {site.socials.map((s) => (
              <a class="transition-colors hover:text-ink" href={s.href} rel="noopener">{s.label}</a>
            ))}
          </nav>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById("theme-toggle");
        if (!button) return;

        const sync = () => {
          const dark = root.classList.contains("dark");
          button.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", dark ? "#080808" : "#f7f7f5");
        };

        sync();

        button.addEventListener("click", () => {
          const dark = root.classList.toggle("dark");
          root.style.colorScheme = dark ? "dark" : "light";
          try {
            localStorage.setItem("orso-theme", dark ? "dark" : "light");
          } catch {}
          sync();
        });
      })();
    </script>
  </body>
</html>
