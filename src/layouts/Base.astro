---
import { buttonVariants } from "@/components/ui/button";
import { href } from "@/lib/href";
import {
  absoluteUrl,
  canonicalUrl,
  documentTitle,
  organizationJsonLd,
} from "@/lib/seo";
import { site } from "@/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Optional social share image (path or absolute URL). */
  image?: string;
  type?: "website" | "article";
  /** Extra JSON-LD graph nodes (Organization is always included). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = "website",
  jsonLd,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const pageTitle = documentTitle(title);
const canonical = canonicalUrl(Astro.url);
const ogImage = absoluteUrl(image ?? "/og.png");
const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const structuredData = [organizationJsonLd(Astro.url), ...extraLd];
import "@fontsource-variable/inter";
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/geist-mono";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fcfcfc" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script is:inline>
      // Scroll reveals only run when motion is welcome; without this class everything stays visible.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("reveal-on");
      }
    </script>
    <script is:inline>
      // Pick the theme before first paint: stored choice first, system second.
      (() => {
        const root = document.documentElement;
        let theme = null;
        try {
          theme = localStorage.getItem("orso-theme");
        } catch {}
        if (theme !== "light" && theme !== "dark") {
          theme = "light";
        }
        const dark = theme === "dark";
        root.classList.toggle("dark", dark);
        root.style.colorScheme = theme;
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", dark ? "#0b0b0c" : "#fcfcfc");
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData.length === 1 ? structuredData[0] : structuredData)} />
  </head>
  <body class="bg-background font-sans text-foreground antialiased">
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-brand focus:px-4 focus:py-2 focus:text-label focus:text-on-brand"
      href="#main"
    >
      Skip to content
    </a>
    <header class="sticky top-0 z-50 border-b border-hairline bg-ground/80 backdrop-blur-md">
      <div class="rails relative mx-auto flex h-14 max-w-6xl items-center gap-5 px-6 sm:px-10 lg:gap-8">
        <div aria-hidden="true" class="absolute inset-x-0 -bottom-px h-px">
          <span class="absolute top-1/2 z-10 size-2 -translate-y-1/2 rounded-full bg-panel shadow-sm shadow-black/10 ring-1 ring-ink/10 left-1 -translate-x-1/2"></span>
          <span class="absolute top-1/2 z-10 size-2 -translate-y-1/2 rounded-full bg-panel shadow-sm shadow-black/10 ring-1 ring-ink/10 right-1 translate-x-1/2"></span>
        </div>
        <a class="relative flex shrink-0 items-center gap-2 text-[15px] font-semibold leading-none tracking-[-0.02em]" href={base}>
          <span aria-hidden="true" class="grid size-5 place-items-center rounded-[6px] bg-brand font-mono text-[11px] text-white">o</span>
          orso <span class="font-normal text-faint">studio</span>
        </a>

        <nav class="hidden items-center gap-5 md:flex lg:gap-6" aria-label="Main">
          {
            site.nav.map((l) => (
              <a
                class="whitespace-nowrap text-[13.5px] font-medium text-muted-ink transition-colors duration-150 hover:text-ink"
                href={href(l.href)}
              >
                {l.label}
              </a>
            ))
          }
        </nav>

        <div class="flex-1"></div>

        <div class="flex items-center gap-2.5">
          <a
            class="hidden whitespace-nowrap text-[13.5px] font-medium text-muted-ink transition-colors hover:text-ink sm:inline"
            href={site.repo}
            rel="noopener"
          >
            GitHub
          </a>
          <a
            class={buttonVariants({ className: "btn-gloss h-8 rounded-[10px] px-3 text-[13px] font-medium tracking-[-0.01em]" })}
            href={href("/download/")}
          >
            Get Orso
          </a>

          <button
            type="button"
            id="theme-toggle"
            class="flex size-8 shrink-0 items-center justify-center rounded-[10px] btn-quiet text-muted-ink transition-colors hover:border-hairline-strong hover:text-ink"
            aria-label="Switch to light theme"
          >
            <svg
              class="hidden size-4 dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4.25"></circle>
              <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4l1.4-1.4M18 6l1.4-1.4"></path>
            </svg>
            <svg
              class="size-4 dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11Z"></path>
            </svg>
          </button>

          <div class="relative md:hidden">
            <button
              type="button"
              id="mobile-nav-toggle"
              class="flex size-8 cursor-pointer items-center justify-center rounded-[10px] btn-quiet text-muted-ink transition-colors hover:text-ink"
              aria-label="Open menu"
              aria-expanded="false"
              aria-controls="mobile-nav"
            >
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                <path d="M2 4h11M2 7.5h11M2 11h11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              </svg>
            </button>
            <nav
              id="mobile-nav"
              class="absolute right-0 top-[calc(100%+0.75rem)] hidden w-56 rounded-xl border border-hairline bg-panel p-2 shadow-2xl shadow-black/10 dark:shadow-black/60"
              aria-label="Mobile"
            >
              {
                site.nav.map((l) => (
                  <a
                    class="block rounded-md px-3 py-2.5 text-label text-muted-ink transition-colors hover:bg-raised hover:text-ink"
                    href={href(l.href)}
                  >
                    {l.label}
                  </a>
                ))
              }
              <a
                class="mt-1 block rounded-md border-t border-hairline px-3 py-2.5 text-label text-muted-ink transition-colors hover:bg-raised hover:text-ink"
                href={site.repo}
                rel="noopener"
              >
                GitHub
              </a>
            </nav>
          </div>
        </div>
      </div>
    </header>

    {/*
      Clip the closing CTA terrain so it can fade behind the footer (DESIGN.md)
      without extending the page past the footer's bottom edge.
    */}
    <div class="relative overflow-clip">
      <main id="main"><slot /></main>

      <footer class="rails relative mx-auto max-w-6xl">
        <div class="flex flex-col gap-12 px-6 pb-8 pt-14 sm:px-10">
          <div class="grid gap-10 sm:grid-cols-[1.5fr_repeat(3,1fr)]">
            <div class="flex flex-col gap-3">
              <a class="flex w-fit items-center gap-2 text-[15px] font-semibold leading-none tracking-[-0.02em]" href={base}>
                <span aria-hidden="true" class="grid size-5 place-items-center rounded-[6px] bg-brand font-mono text-[11px] text-white">o</span>
                orso <span class="font-normal text-faint">studio</span>
              </a>
              <p class="max-w-[260px] text-[13px] leading-relaxed text-muted-ink">{site.footer.tagline}</p>
            </div>
            {
              site.footer.columns.map((column) => (
                <div class="flex flex-col gap-3">
                  <p class="font-mono text-[11.5px] text-faint">{column.title}</p>
                  {column.links.map((link) => (
                    <a
                      class="w-fit text-[13.5px] text-muted-ink transition-colors duration-150 hover:text-ink"
                      href={href(link.href)}
                      rel={"external" in link ? "noopener" : undefined}
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              ))
            }
          </div>

          <div class="flex flex-wrap items-center justify-between gap-4 border-t border-dashed border-hairline-strong pt-6 text-[12.5px] text-faint">
            <p>{site.footer.text}</p>
            <nav class="flex flex-wrap items-center gap-5" aria-label="Footer">
              {site.footer.links.map((l) => (
                <a class="transition-colors hover:text-ink" href={href(l.href)}>{l.label}</a>
              ))}
              <span class="flex items-center gap-1.5 font-mono text-[11.5px]">
                <span class="size-1.5 rounded-full bg-live"></span>open source
              </span>
            </nav>
          </div>
        </div>
      </footer>
    </div>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById("theme-toggle");
        if (button) {
          const sync = () => {
            const dark = root.classList.contains("dark");
            button.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
            const meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute("content", dark ? "#080808" : "#f7f7f5");
          };

          sync();

          button.addEventListener("click", () => {
            const dark = root.classList.toggle("dark");
            root.style.colorScheme = dark ? "dark" : "light";
            try {
              localStorage.setItem("orso-theme", dark ? "dark" : "light");
            } catch {}
            sync();
          });
        }

        const navToggle = document.getElementById("mobile-nav-toggle");
        const nav = document.getElementById("mobile-nav");
        if (navToggle && nav) {
          const setOpen = (open) => {
            nav.classList.toggle("hidden", !open);
            navToggle.setAttribute("aria-expanded", open ? "true" : "false");
            navToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
          };

          navToggle.addEventListener("click", () => {
            setOpen(nav.classList.contains("hidden"));
          });

          document.addEventListener("click", (event) => {
            if (!nav.classList.contains("hidden") && !navToggle.contains(event.target) && !nav.contains(event.target)) {
              setOpen(false);
            }
          });

          document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") setOpen(false);
          });
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const items = document.querySelectorAll("[data-reveal]");
        if (!items.length) return;
        if (!document.documentElement.classList.contains("reveal-on") || !("IntersectionObserver" in window)) {
          items.forEach((el) => el.classList.add("is-in"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
        );
        items.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
