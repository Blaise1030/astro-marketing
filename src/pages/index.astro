---
import Comparison from "../components/sections/Comparison.astro";
import Cta from "../components/sections/Cta.astro";
import Faq from "../components/sections/Faq.astro";
import Features from "../components/sections/Features.astro";
import Hero from "../components/sections/Hero.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import Stack from "../components/sections/Stack.astro";
import Tools from "../components/sections/Tools.astro";
import Base from "../layouts/Base.astro";
import { faqs } from "../lib/faqs";
import { faqPageJsonLd } from "../lib/seo";
---

<Base
  title="Orso — A free studio for Astro sites, with the agent you already pay for"
  description="Orso is a free, open-source studio for Astro sites. Edit Markdown in a real UI, or ask Claude, Cursor or Codex. Preview every draft locally, publish static files to the host you choose — no lock-in."
  jsonLd={faqPageJsonLd([...faqs])}
>
  <Hero />
  <Tools />
  <Features />
  <HowItWorks />
  <Stack />
  <Comparison />
  <Faq />
  <Cta />
</Base>
