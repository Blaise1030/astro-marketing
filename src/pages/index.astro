---
import Divider from "../components/landing/Divider.astro";
import About from "../components/sections/About.astro";
import Cta from "../components/sections/Cta.astro";
import Faq from "../components/sections/Faq.astro";
import Hero from "../components/sections/Hero.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import Stack from "../components/sections/Stack.astro";
import Setup from "../components/sections/Setup.astro";
import Base from "../layouts/Base.astro";
import { site } from "../site";
import { faqs } from "../lib/faqs";
import { faqPageJsonLd } from "../lib/seo";
---

<Base
  title="Project Orso — A shared workspace for your website"
  description={site.description}
  jsonLd={faqPageJsonLd([...faqs])}
>
  <!-- One framed column: double rails down each side, a dotted hairline between sections -->
  <div class="rails relative mx-auto max-w-6xl">
    <Hero />
    <Divider />
    <Stack />
    <Divider />
    <HowItWorks />
    <Divider />
    <About />
    <Divider />
    <Setup />
    <Divider />
    <Faq />
    <Divider />
    <Cta />
    <Divider />
  </div>
</Base>
