---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import HelpSearch from "../../components/HelpSearch.astro";
import DocRows from "../../components/landing/DocRows.astro";
import Divider from "../../components/landing/Divider.astro";
import PageHeader from "../../components/landing/PageHeader.astro";
import Rails from "../../components/landing/Rails.astro";
import SectionIntro from "../../components/landing/SectionIntro.astro";
import Serif from "../../components/landing/Serif.astro";
import TopicCard from "../../components/landing/TopicCard.astro";
import { href } from "../../lib/href";
import { loadHelp } from "../../lib/help";

const docs = await getCollection("helpDocs");
const docsCategories = (await getCollection("helpDocsCategories")).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title) || a.id.localeCompare(b.id),
);
const docsByCategory = new Map(docsCategories.map((category) => [category.id, [] as typeof docs]));
for (const doc of docs) {
  if (!doc.data.category) continue;
  const list = docsByCategory.get(doc.data.category);
  if (list) list.push(doc);
}
for (const list of docsByCategory.values()) {
  list.sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title) || a.id.localeCompare(b.id));
}
const sections = docsCategories.filter((category) => (docsByCategory.get(category.id)?.length ?? 0) > 0);
const { categories } = await loadHelp(getCollection);
---
<Base title="Orso Help" description="Guides for editing content, previewing changes, and publishing your Astro site with Orso." image="/og-help.png">
  <Rails>
    <PageHeader tag="Help center" lead="Guides for editing content, previewing drafts and publishing your Astro site with Orso.">
      How can we <Serif>help</Serif>?
      <div slot="after" class="max-w-xl pt-2"><HelpSearch /></div>
    </PageHeader>
    <Divider />

    {categories.length === 0 ? <p class="px-6 py-14 text-muted-ink sm:px-10">No help docs yet. Check back soon for guides and answers.</p> : (
      <section class="flex flex-col gap-12 px-6 py-16 sm:px-10">
        <SectionIntro tag="Sections">Start with a <Serif>topic</Serif>.</SectionIntro>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {categories.map((category) => (
            <TopicCard
              href={`/help/section/${category.slug}/`}
              title={category.name}
              description={category.description}
              meta={`${category.docs.length} ${category.docs.length === 1 ? "article" : "articles"}`}
              items={category.docs.map((doc) => doc.data.title)}
            />
          ))}
        </div>
      </section>
    )}

    {sections.map((category) => (
      <>
        <Divider />
        <section class="grid gap-10 px-6 py-16 sm:px-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16" id={category.data.slug}>
          <div class="flex flex-col gap-5 lg:sticky lg:top-24 lg:self-start">
            <SectionIntro tag="Guides">{category.data.title}</SectionIntro>
            {category.data.description && <p class="max-w-sm text-[15px] leading-relaxed text-muted-ink">{category.data.description}</p>}
            <a class="group w-fit font-mono text-[12px] text-faint transition-colors hover:text-ink" href={href(`/help/categories/${category.data.slug}/`)}>
              view all <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
            </a>
          </div>
          <DocRows items={docsByCategory.get(category.id)!.map((doc) => ({ href: `/help/${doc.id}/`, title: doc.data.title, description: doc.data.description }))} />
        </section>
      </>
    ))}
    <Divider />
  </Rails>
</Base>
