---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import HelpCard from "../../components/HelpCard.astro";
import HelpFilters from "../../components/HelpFilters.astro";
import { sectionsOf, sortDocs } from "../../lib/help";
const docs = sortDocs(await getCollection("helpDocs"));
---
<Base title="Orso Help" description="Guides for editing content, previewing changes, and publishing with Orso.">
  <section class="mx-auto max-w-6xl px-6 py-section sm:px-8 sm:py-section-wide">
    <h1 class="sr-only">Help</h1>
    <HelpFilters sections={sectionsOf(docs)} />
    {docs.length === 0 ? <p>No help docs yet. Check back soon for guides and answers.</p> : (
      <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">{docs.map((doc) => <HelpCard doc={doc} />)}</div>
    )}
  </section>
</Base>
