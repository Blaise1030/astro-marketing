---
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/href";
import { loadHelp } from "../../lib/categories";
const groups = await loadHelp();
---
<Base title="Help" description="Guides and answers to help you get started.">
  <section class="mx-auto max-w-5xl px-8 py-12">
    <h1 class="mb-8 text-4xl font-semibold tracking-tight">Help</h1>
    {groups.length > 1 && (
      <nav aria-label="Help categories" class="mb-10">
        <ul class="flex flex-wrap gap-2">{groups.map(({ category }) => (
          <li><a class="rounded-full border border-tertiary px-3 py-1 text-body-sm text-secondary hover:bg-surface dark:border-neutral-700 dark:text-neutral-400 dark:hover:bg-neutral-900" href={`#${category.id}`}>{category.data.title}</a></li>
        ))}</ul>
      </nav>
    )}
    {groups.length === 0 ? <p class="text-secondary dark:text-neutral-400">No help docs yet. Check back soon for guides and answers.</p> : groups.map(({ category, docs }) => (
      <section id={category.id} class="mb-10 scroll-mt-8">
        <h2 class="text-2xl font-semibold">{category.data.title}</h2>
        {category.data.description && <p class="mt-1 text-body-sm text-secondary dark:text-neutral-400">{category.data.description}</p>}
        <div class="mt-4 grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-md">{docs.map((doc) => (
          <article class="rounded-lg border border-tertiary p-5 hover:bg-surface dark:border-neutral-800 dark:hover:bg-neutral-900">
            <h3 class="text-lg font-semibold"><a class="hover:text-accent" href={href(`/help/${doc.id}/`)}>{doc.data.title}</a></h3>
            <p class="mt-2 text-body-sm text-secondary dark:text-neutral-400">{doc.data.description}</p>
          </article>
        ))}</div>
      </section>
    ))}
  </section>
</Base>
