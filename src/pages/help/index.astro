---
import { getCollection } from "astro:content";
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Empty, EmptyDescription, EmptyHeader, EmptyTitle } from "@/components/ui/empty";
import Base from "@/layouts/Base.astro";
import { href } from "@/lib/href";
const docs = (await getCollection("helpDocs")).sort((a, b) => a.data.section.localeCompare(b.data.section) || a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const sections = [...new Set(docs.map((doc) => doc.data.section))];
---
<Base title="Help" description="Guides and answers to help you get started.">
  <section class="mx-auto max-w-5xl px-8 py-12">
    <h1 class="mb-8 text-h2">Help</h1>
    {docs.length === 0 ? (
      <Empty className="border border-tertiary/30">
        <EmptyHeader>
          <EmptyTitle>No help docs yet</EmptyTitle>
          <EmptyDescription>Check back soon for guides and answers.</EmptyDescription>
        </EmptyHeader>
      </Empty>
    ) : sections.map((section) => (
      <section class="mb-10">
        <h2 class="mb-4 text-2xl font-semibold">{section}</h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-md">
          {docs.filter((doc) => doc.data.section === section).map((doc) => (
            <Card size="sm">
              <CardHeader>
                <CardTitle>
                  <h3><a class="hover:underline" href={href(`/help/${doc.id}/`)}>{doc.data.title}</a></h3>
                </CardTitle>
                <CardDescription>{doc.data.description}</CardDescription>
              </CardHeader>
            </Card>
          ))}
        </div>
      </section>
    ))}
  </section>
</Base>
