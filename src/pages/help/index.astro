---
import { getCollection } from "astro:content";
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Empty, EmptyDescription, EmptyHeader, EmptyTitle } from "@/components/ui/empty";
import Base from "@/layouts/Base.astro";
import { href } from "@/lib/href";
const docs = (await getCollection("helpDocs")).sort((a, b) => a.data.section.localeCompare(b.data.section) || a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const sections = [...new Set(docs.map((doc) => doc.data.section))];
---
<Base title="Help" description="Guides and answers to help you get started.">
  <section class="shell py-20 sm:py-section">
    <h1 class="text-h2">Help</h1>
    <p class="mt-4 max-w-lg text-body text-muted-ink">Guides and answers for getting set up, editing content and publishing.</p>

    {docs.length === 0 ? (
      <Empty>
        <EmptyHeader>
          <EmptyTitle>No help docs yet</EmptyTitle>
          <EmptyDescription>Check back soon for guides and answers.</EmptyDescription>
        </EmptyHeader>
      </Empty>
    ) : sections.map((section) => (
      <section class="mt-14">
        <p class="text-eyebrow uppercase text-faint">{section}</p>
        <div class="mt-5 grid grid-cols-[repeat(auto-fit,minmax(16rem,1fr))] gap-7">
          {docs.filter((doc) => doc.data.section === section).map((doc) => (
            <Card size="sm" className="transition-colors hover:ring-hairline-strong">
              <CardHeader>
                <CardTitle>
                  <h2 class="text-h3"><a class="transition-colors hover:text-muted-ink" href={href(`/help/${doc.id}/`)}>{doc.data.title}</a></h2>
                </CardTitle>
                <CardDescription className="text-body">{doc.data.description}</CardDescription>
              </CardHeader>
            </Card>
          ))}
        </div>
      </section>
    ))}
  </section>
</Base>
