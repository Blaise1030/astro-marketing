---
import { getCollection, render } from "astro:content";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import Base from "@/layouts/Base.astro";
import { href } from "@/lib/href";

export async function getStaticPaths() {
  return (await getCollection("helpDocs")).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <article class="shell py-20 sm:py-section">
    <div class="max-w-3xl">
      <a class={buttonVariants({ variant: "link", className: "h-auto px-0 text-label text-muted-ink" })} href={href("/help/")}>
        ← Back to Help
      </a>
      <p class="mt-8"><Badge variant="outline" className="border-hairline text-muted-ink">{entry.data.section}</Badge></p>
      <h1 class="mt-3 text-h2">{entry.data.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted-ink">{entry.data.description}</p>
      <div class="prose prose-invert mt-10 max-w-3xl prose-img:h-auto prose-img:max-w-full"><Content /></div>
    </div>
  </article>
</Base>
