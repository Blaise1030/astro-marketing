---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/href";
import { loadHelp } from "../../lib/help";
import Divider from "../../components/landing/Divider.astro";
import PageHeader from "../../components/landing/PageHeader.astro";
import Rails from "../../components/landing/Rails.astro";
import { proseClass } from "../../lib/prose";

export async function getStaticPaths() {
  const { docs, categories } = await loadHelp(getCollection);
  return docs.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, previous: docs[index - 1], next: docs[index + 1], categories },
  }));
}
const { entry, previous, next, categories } = Astro.props;
const category = categories.find((c) => c.slug === entry.data.section);
const subcategory = category?.subcategories.find((s) => s.slug === entry.data.subcategory);
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const linkClass = "transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand";
const navCard = "frame group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand";
---
<Base title={entry.data.title} description={entry.data.description} image="/og-help.png">
  <Rails>
    <article data-pagefind-body>
      <PageHeader tag={category?.name ?? "Help"} back={{ href: "/help/", label: "Help center" }} lead={entry.data.description}>
        <Fragment slot="meta">
          {category && <a class={`font-mono text-[12px] text-faint ${linkClass}`} href={href(`/help/section/${entry.data.section}/`)} data-pagefind-ignore>{category.name.toLowerCase()}{subcategory && ` / ${subcategory.name.toLowerCase()}`}</a>}
        </Fragment>
        {entry.data.title}
      </PageHeader>
      <Divider />
      <div class="grid gap-10 px-6 py-14 sm:px-10 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-16">
        <div class="min-w-0">
          <div class={`${proseClass} max-w-3xl`}><Content /></div>
          {(previous || next) && (
            <nav data-pagefind-ignore class="mt-16 grid max-w-3xl gap-4 sm:grid-cols-2" aria-label="More docs">
              <div>{previous && <a class={navCard} href={href(`/help/${previous.id}/`)}><span class="frame-inner block p-4"><span class="block font-mono text-[11.5px] text-faint">← previous</span><span class="mt-1.5 block text-[15px] font-medium tracking-[-0.015em] transition-colors group-hover:text-brand-ink">{previous.data.title}</span></span></a>}</div>
              <div class="sm:text-right">{next && <a class={navCard} href={href(`/help/${next.id}/`)}><span class="frame-inner block p-4"><span class="block font-mono text-[11.5px] text-faint">next →</span><span class="mt-1.5 block text-[15px] font-medium tracking-[-0.015em] transition-colors group-hover:text-brand-ink">{next.data.title}</span></span></a>}</div>
            </nav>
          )}
        </div>
        {toc.length > 0 && (
          <aside class="lg:sticky lg:top-24 lg:self-start" data-pagefind-ignore>
            <nav aria-label="On this page">
              <p class="font-mono text-[11.5px] text-faint">on this page</p>
              <ul class="mt-3 flex flex-col border-l border-dashed border-hairline-strong">
                {toc.map((heading) => (
                  <li>
                    <a class:list={["-ml-px block border-l border-transparent py-1.5 text-[13.5px] leading-snug text-muted-ink hover:border-brand", linkClass, heading.depth > 2 ? "pl-6" : "pl-3"]} href={`#${heading.slug}`}>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
      </div>
    </article>
    <Divider />
  </Rails>
</Base>
