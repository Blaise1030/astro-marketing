---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/href";
import { slugify, sortDocs } from "../../lib/help";

export async function getStaticPaths() {
  const docs = sortDocs(await getCollection("helpDocs"));
  return docs.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, previous: docs[index - 1], next: docs[index + 1], siblings: docs.filter((doc) => doc.data.section === entry.data.section) },
  }));
}
const { entry, previous, next, siblings } = Astro.props;
const { Content } = await render(entry);
const linkClass = "transition-colors hover:text-brand-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent";
---
<Base title={entry.data.title} description={entry.data.description}>
  <article class="mx-auto max-w-6xl px-6 py-section sm:px-8 sm:py-section-wide">
    <a class={`text-xs text-brand-muted ${linkClass}`} href={href("/help/")}>← All docs</a>
    <p class="mt-8 text-xs font-medium uppercase tracking-wide text-brand-muted"><a class={linkClass} href={href(`/help/section/${slugify(entry.data.section)}/`)}>{entry.data.section}</a></p>
    <h1 class="mt-4 max-w-3xl font-medium text-4xl leading-tight tracking-tight text-balance sm:text-5xl">{entry.data.title}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-brand-muted">{entry.data.description}</p>
    <div class="mt-12 grid gap-10 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
      <aside class="text-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-brand-muted">{entry.data.section}</p>
        <nav class="mt-3 flex flex-col gap-2" aria-label="In this section">
          {siblings.map((doc) => <a class={`${linkClass} ${doc.id === entry.id ? "font-medium text-brand-foreground" : "text-brand-muted"}`} href={href(`/help/${doc.id}/`)} aria-current={doc.id === entry.id ? "page" : undefined}>{doc.data.title}</a>)}
        </nav>
      </aside>
      <div>
        <div class="prose max-w-2xl break-words dark:prose-invert prose-headings:font-medium prose-headings:tracking-tight prose-a:text-brand-accent prose-a:decoration-brand-accent/40 prose-a:underline-offset-4 prose-pre:border prose-pre:border-section-line prose-pre:bg-section-panel prose-pre:text-brand-foreground prose-img:h-auto prose-img:max-w-full"><Content /></div>
        {(previous || next) && (
          <nav class="mt-16 grid max-w-2xl grid-cols-2 gap-8 border-t border-section-line pt-6 text-sm" aria-label="More docs">
            <div>{previous && <a class={`block ${linkClass}`} href={href(`/help/${previous.id}/`)}><span class="block text-xs uppercase tracking-wide text-brand-muted">← Previous</span><span class="mt-2 block font-medium">{previous.data.title}</span></a>}</div>
            <div class="text-right">{next && <a class={`block ${linkClass}`} href={href(`/help/${next.id}/`)}><span class="block text-xs uppercase tracking-wide text-brand-muted">Next →</span><span class="mt-2 block font-medium">{next.data.title}</span></a>}</div>
          </nav>
        )}
      </div>
    </div>
  </article>
</Base>
