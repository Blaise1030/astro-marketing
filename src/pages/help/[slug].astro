---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/href";
import { loadHelp } from "../../lib/help";

export async function getStaticPaths() {
  const { docs, categories } = await loadHelp(getCollection);
  return docs.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, previous: docs[index - 1], next: docs[index + 1], categories },
  }));
}
const { entry, previous, next, categories } = Astro.props;
const category = categories.find((c) => c.slug === entry.data.section);
const subcategory = category?.subcategories.find((s) => s.slug === entry.data.subcategory);
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const linkClass = "transition-colors hover:text-brand-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent";
---
<Base title={entry.data.title} description={entry.data.description}>
  <article class="mx-auto max-w-7xl px-6 pt-8 pb-section sm:px-8 sm:py-section-wide" data-pagefind-body>
    <a class={`text-xs text-brand-muted ${linkClass}`} href={href("/help/")}>← Back to Help</a>
    {(category || subcategory) && (
      <p class="mt-8 text-sm font-medium capitalize text-brand-muted">
        {category && <a class={linkClass} href={href(`/help/section/${entry.data.section}/`)}>{category.name}</a>}
        {subcategory && <span> / {subcategory.name}</span>}
      </p>
    )}
    <h1 class="mt-4 max-w-3xl font-medium text-4xl leading-tight tracking-tight text-balance sm:text-5xl">{entry.data.title}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-brand-muted">{entry.data.description}</p>
    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-16">
      <div class="min-w-0">
        <div class="prose max-w-4xl break-words dark:prose-invert prose-headings:font-medium prose-headings:tracking-tight prose-a:text-brand-accent prose-a:decoration-brand-accent/40 prose-a:underline-offset-4 prose-pre:border prose-pre:border-section-line prose-pre:bg-section-panel prose-pre:text-brand-foreground prose-img:h-auto prose-img:max-w-full"><Content /></div>
        {(previous || next) && (
          <nav data-pagefind-ignore class="mt-16 grid max-w-4xl grid-cols-2 gap-8 border-t border-section-line pt-6 text-sm" aria-label="More docs">
            <div>{previous && <a class={`block ${linkClass}`} href={href(`/help/${previous.id}/`)}><span class="block text-xs uppercase tracking-wide text-brand-muted">← Previous</span><span class="mt-2 block font-medium">{previous.data.title}</span></a>}</div>
            <div class="text-right">{next && <a class={`block ${linkClass}`} href={href(`/help/${next.id}/`)}><span class="block text-xs uppercase tracking-wide text-brand-muted">Next →</span><span class="mt-2 block font-medium">{next.data.title}</span></a>}</div>
          </nav>
        )}
      </div>
      {toc.length > 0 && (
        <aside class="text-sm lg:sticky lg:top-24 lg:self-start" data-pagefind-ignore>
          <nav class="flex flex-col" aria-label="On this page">
            <p class="text-xs font-medium uppercase tracking-wide text-brand-muted">On this page</p>
            <ul class="mt-3 space-y-2">
              {toc.map((heading) => (
                <li class:list={[heading.depth > 2 && "pl-3"]}>
                  <a class={`block leading-snug ${linkClass} text-brand-muted`} href={`#${heading.slug}`}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>
  </article>
</Base>
