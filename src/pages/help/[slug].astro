---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/href";

export async function getStaticPaths() {
  return (await getCollection("helpDocs")).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <article class="mx-auto max-w-5xl px-8 py-12">
    <a class="text-label hover:underline" href={href("/help/")}>Back to Help</a>
    <h1 class="mt-4 text-h2">{entry.data.title}</h1>
    <p class="mt-2 text-lg text-muted-foreground">{entry.data.description}</p>
    <p class="mt-2 text-label text-tertiary">{entry.data.section}</p>
    <div class="prose mt-8 max-w-3xl dark:prose-invert prose-img:h-auto prose-img:max-w-full"><Content /></div>
  </article>
</Base>
