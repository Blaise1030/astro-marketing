---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import HelpCard from "../../../components/HelpCard.astro";
import HelpFilters from "../../../components/HelpFilters.astro";
import { sectionsOf, slugify, sortDocs } from "../../../lib/help";
export async function getStaticPaths() {
  const docs = sortDocs(await getCollection("helpDocs"));
  const sections = sectionsOf(docs);
  return sections.map((section) => ({
    params: { section: slugify(section) },
    props: { section, sections, docs: docs.filter((doc) => doc.data.section === section) },
  }));
}
const { section, sections, docs } = Astro.props;
---
<Base title={`${section} · Orso Help`} description={`Orso help guides: ${section}.`}>
  <section class="mx-auto max-w-6xl px-6 py-section sm:px-8 sm:py-section-wide">
    <h1 class="sr-only">{section}</h1>
    <HelpFilters sections={sections} active={section} />
    <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">{docs.map((doc) => <HelpCard doc={doc} />)}</div>
  </section>
</Base>
