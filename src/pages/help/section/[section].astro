---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import DocRows from "../../../components/landing/DocRows.astro";
import Divider from "../../../components/landing/Divider.astro";
import PageHeader from "../../../components/landing/PageHeader.astro";
import Rails from "../../../components/landing/Rails.astro";
import Tag from "../../../components/landing/Tag.astro";
import { loadHelp } from "../../../lib/help";
export async function getStaticPaths() {
  const { categories } = await loadHelp(getCollection);
  return categories.map((category) => ({ params: { section: category.slug }, props: { category } }));
}
const { category } = Astro.props;
const rows = (docs: typeof category.loose) => docs.map((doc) => ({ href: `/help/${doc.id}/`, title: doc.data.title, description: doc.data.description }));
---
<Base title={`${category.name} · Project Orso Help`} description={category.description} image="/og-help.png">
  <Rails>
    <div data-pagefind-ignore>
      <PageHeader tag="Help section" back={{ href: "/help/", label: "Help center" }} lead={category.description}>
        {category.name}
      </PageHeader>
      {category.loose.length > 0 && (
        <>
          <Divider />
          <section class="px-6 py-12 sm:px-10"><DocRows items={rows(category.loose)} /></section>
        </>
      )}
      {category.subcategories.map((sub) => (
        <>
          <Divider />
          <section class="grid gap-8 px-6 py-12 sm:px-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
            <div class="flex flex-col gap-3 lg:sticky lg:top-24 lg:self-start">
              <Tag>{sub.name}</Tag>
              <p class="font-mono text-[12px] text-faint">{sub.docs.length} {sub.docs.length === 1 ? "article" : "articles"}</p>
            </div>
            <DocRows items={rows(sub.docs)} />
          </section>
        </>
      ))}
      <Divider />
    </div>
  </Rails>
</Base>
