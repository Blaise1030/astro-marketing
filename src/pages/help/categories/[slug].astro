---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import DocRows from "../../../components/landing/DocRows.astro";
import Divider from "../../../components/landing/Divider.astro";
import PageHeader from "../../../components/landing/PageHeader.astro";
import Rails from "../../../components/landing/Rails.astro";

export async function getStaticPaths() {
  return (await getCollection("helpDocsCategories")).map((category) => ({
    params: { slug: category.data.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const docs = (await getCollection("helpDocs"))
  .filter((doc) => doc.data.category === category.id)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title) || a.id.localeCompare(b.id));
---
<Base title={category.data.title} description={category.data.description ?? `Help guides in ${category.data.title}.`} image="/og-help.png">
  <Rails>
    <PageHeader tag="Help category" back={{ href: "/help/categories/", label: "All categories" }} lead={category.data.description}>
      {category.data.title}
    </PageHeader>
    <Divider />
    <section class="px-6 py-12 sm:px-10">
      {docs.length === 0 ? <p class="text-muted-ink">No guides in this category yet.</p> : (
        <DocRows items={docs.map((doc) => ({ href: `/help/${doc.id}/`, title: doc.data.title, description: doc.data.description }))} />
      )}
    </section>
    <Divider />
  </Rails>
</Base>
