---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { href } from "../../../lib/href";

export async function getStaticPaths() {
  return (await getCollection("helpDocsCategories")).map((category) => ({
    params: { slug: category.data.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const docs = (await getCollection("helpDocs"))
  .filter((doc) => doc.data.category === category.id)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title) || a.id.localeCompare(b.id));
---
<Base title={category.data.title} description={category.data.description ?? `Help guides in ${category.data.title}.`}>
  <section class="mx-auto max-w-5xl px-8 py-12">
    <a class="text-sm hover:underline" href={href("/help/categories/")}>Back to categories</a>
    <h1 class="mt-4 mb-2 text-4xl font-bold tracking-tight">{category.data.title}</h1>
    {category.data.description && <p class="mb-8 text-lg text-neutral-600 dark:text-neutral-400">{category.data.description}</p>}
    {docs.length === 0 ? <p class="mt-8">No guides in this category yet.</p> : (
      <div class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-6">{docs.map((doc) => (
        <article class="rounded-xl border border-neutral-400/30 p-5">
          <h2 class="text-lg font-semibold"><a class="hover:underline" href={href(`/help/${doc.id}/`)}>{doc.data.title}</a></h2>
          <p class="mt-2">{doc.data.description}</p>
        </article>
      ))}</div>
    )}
  </section>
</Base>
