---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { href } from "../../../lib/href";

export async function getStaticPaths() {
  return (await getCollection("helpDocsCategories")).map((category) => ({
    params: { slug: category.data.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const docs = (await getCollection("helpDocs"))
  .filter((doc) => doc.data.category === category.id)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title) || a.id.localeCompare(b.id));
---
<Base title={category.data.title} description={category.data.description ?? `Help guides in ${category.data.title}.`}>
  <section class="mx-auto max-w-7xl px-6 py-section sm:px-8 sm:py-section-wide">
    <a class="text-sm text-brand-muted transition-colors hover:text-brand-accent" href={href("/help/")}>Back to Help</a>
    <h1 class="mt-4 text-4xl font-medium tracking-tight">{category.data.title}</h1>
    {category.data.description && <p class="mt-3 max-w-2xl leading-relaxed text-brand-muted">{category.data.description}</p>}
    {docs.length === 0 ? <p class="mt-10">No guides in this category yet.</p> : (
      <div class="mt-10 grid gap-x-8 gap-y-8 sm:gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {docs.map((doc) => (
          <article class="group">
            <a
              class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent"
              href={href(`/help/${doc.id}/`)}
            >
              <div class="aspect-[3/2] overflow-hidden bg-ui-fill">
                <div
                  class="h-full w-full bg-[repeating-radial-gradient(circle_at_30%_60%,transparent_0_14px,var(--color-brand-accent)_14px_15px)] opacity-30"
                  aria-hidden="true"
                >
                </div>
              </div>
              <h2 class="mt-5 text-xl font-medium tracking-tight text-balance transition-colors group-hover:text-brand-accent">
                {doc.data.title}
              </h2>
              <p class="mt-3 leading-relaxed text-brand-muted">{doc.data.description}</p>
            </a>
          </article>
        ))}
      </div>
    )}
  </section>
</Base>
