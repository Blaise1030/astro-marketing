---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Divider from "../../../components/landing/Divider.astro";
import PageHeader from "../../../components/landing/PageHeader.astro";
import Rails from "../../../components/landing/Rails.astro";
import Serif from "../../../components/landing/Serif.astro";
import TopicCard from "../../../components/landing/TopicCard.astro";

const categories = (await getCollection("helpDocsCategories")).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title) || a.data.slug.localeCompare(b.data.slug),
);
const docs = await getCollection("helpDocs");
const docsIn = (id: string) => docs.filter((doc) => doc.data.category === id);
---
<Base title="Help categories" description="Browse Orso help guides by topic — getting started, editing, publishing, and troubleshooting." image="/og-help.png">
  <Rails>
    <PageHeader tag="Help" back={{ href: "/help/", label: "Help center" }}>
      Guides by <Serif>topic</Serif>.
    </PageHeader>
    <Divider />
    <section class="px-6 py-14 sm:px-10">
      {categories.length === 0 ? <p class="text-muted-ink">No help categories yet.</p> : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {categories.map((category) => {
            const list = docsIn(category.id);
            return (
              <TopicCard
                href={`/help/categories/${category.data.slug}/`}
                title={category.data.title}
                description={category.data.description}
                meta={`${list.length} ${list.length === 1 ? "guide" : "guides"}`}
                items={list.map((doc) => doc.data.title)}
              />
            );
          })}
        </div>
      )}
    </section>
    <Divider />
  </Rails>
</Base>
