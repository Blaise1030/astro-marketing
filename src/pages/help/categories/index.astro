---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { href } from "../../../lib/href";

const categories = (await getCollection("helpDocsCategories")).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title) || a.data.slug.localeCompare(b.data.slug),
);
---
<Base title="Help categories" description="Browse help by category.">
  <section class="mx-auto max-w-7xl px-6 py-section sm:px-8 sm:py-section-wide">
    <a class="text-sm text-brand-muted transition-colors hover:text-brand-accent" href={href("/help/")}>Back to Help</a>
    <h1 class="mt-4 mb-10 text-4xl font-medium tracking-tight">Help categories</h1>
    {categories.length === 0 ? <p>No help categories yet.</p> : (
      <div class="grid gap-x-8 gap-y-8 sm:gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((category) => (
          <article class="group">
            <a
              class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent"
              href={href(`/help/categories/${category.data.slug}/`)}
            >
              <div class="aspect-[3/2] overflow-hidden bg-ui-fill">
                <div
                  class="h-full w-full bg-[repeating-radial-gradient(circle_at_30%_60%,transparent_0_14px,var(--color-brand-accent)_14px_15px)] opacity-30"
                  aria-hidden="true"
                >
                </div>
              </div>
              <h2 class="mt-5 text-xl font-medium tracking-tight text-balance transition-colors group-hover:text-brand-accent">
                {category.data.title}
              </h2>
              {category.data.description && (
                <p class="mt-3 leading-relaxed text-brand-muted">{category.data.description}</p>
              )}
            </a>
          </article>
        ))}
      </div>
    )}
  </section>
</Base>
