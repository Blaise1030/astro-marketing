---
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.astro";
import { site } from "../site";
const { url, platform } = site.download;
---
<Base title="Download Orso" description="Download the Orso studio for macOS — edit Markdown, ask your coding agent, and preview your Astro site locally.">
  <section class="mx-auto max-w-3xl px-6 py-section text-center sm:px-8 sm:py-section-wide">
    <h1 class="font-semibold text-5xl tracking-tight text-balance sm:text-6xl">Download Orso</h1>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-brand-muted">A free desktop studio for Astro sites. Edit Markdown, ask Claude, Cursor or Codex, and preview every draft locally.</p>
    <div class="mt-10 flex flex-col items-center gap-3">
      {url
        ? <Button href={url}>Download for {platform}</Button>
        : <p class="rounded-lg border border-section-line bg-section-panel px-5 py-3 text-sm text-brand-muted">The {platform} download is coming soon.</p>}
      <p class="text-xs text-brand-muted">Available for {platform}.</p>
    </div>
  </section>
</Base>
