---
import Base from "../layouts/Base.astro";
import { CopyCommand } from "../components/copy-command";
import { site } from "../site";

const { installCommand, brewCommand, runCommand, platforms } = site.download;
---
<Base title="Download Orso" description="Install Orso with a one-line bash script on macOS or Linux — edit Markdown, ask your coding agent, and preview your Astro site locally.">
  <section class="mx-auto max-w-3xl px-6 py-section sm:px-8 sm:py-section-wide">
    <div class="text-center">
      <h1 class="font-semibold text-5xl tracking-tight text-balance sm:text-6xl">Install Orso</h1>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-brand-muted">
        A free desktop studio for Astro sites. One command installs the CLI on {platforms}.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-2xl">
      <CopyCommand client:load command={installCommand} />
      <p class="mt-4 text-center text-sm text-brand-muted">
        Then start it with{" "}
        <code class="rounded-md border border-section-line bg-section-panel px-1.5 py-0.5 font-mono text-[0.8125rem] text-brand-foreground">{runCommand}</code>
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-2xl rounded-2xl border border-section-line bg-section-panel px-5 py-4 text-sm leading-relaxed text-brand-muted">
      <p class="font-medium text-brand-foreground">Prefer Homebrew on macOS?</p>
      <pre class="mt-3 overflow-x-auto font-mono text-[0.8125rem] text-brand-foreground"><code>{brewCommand}</code></pre>
      <p class="mt-3">
        The curl script downloads the matching GitHub Release, checks the sha256, and puts{" "}
        <code class="text-brand-foreground">orso</code> on your PATH (default{" "}
        <code class="text-brand-foreground">~/.local/bin</code>).
      </p>
    </div>

    <p class="mt-8 text-center text-xs text-brand-muted">
      Available for {platforms}.{" "}
      <a class="underline underline-offset-4 hover:text-brand-foreground" href={site.repo}>Source on GitHub</a>
    </p>
  </section>
</Base>
