---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/href";
const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate) || a.id.localeCompare(b.id));
const categoryOf = (post: (typeof posts)[number]) => post.data.tags[0] ?? "general";
const categories = [...new Set(posts.map(categoryOf))].sort();
const formatDate = (value: string) => new Date(`${value}T00:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
const filterClass = "border-b border-transparent pb-0.5 text-xs font-medium uppercase tracking-wide text-brand-muted transition-colors hover:text-brand-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent aria-pressed:border-brand-foreground aria-pressed:text-brand-foreground";
---
<Base title="Orso Blog" description="Product notes and practical guides for maintaining an Astro site with Orso.">
  <section class="mx-auto max-w-6xl px-6 py-section sm:px-8 sm:py-section-wide">
    <div class="mb-12 flex flex-wrap items-center gap-x-10 gap-y-4" role="group" aria-label="Filter posts by category">
      <h1 class="text-xs font-semibold uppercase tracking-wide">/// All posts</h1>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <button type="button" data-filter="all" aria-pressed="true" class={filterClass}>All</button>
        {categories.map((category) => <button type="button" data-filter={category} aria-pressed="false" class={filterClass}>{category}</button>)}
      </div>
    </div>
    {posts.length === 0 ? <p>No blog posts yet. Check back soon for news and stories.</p> : (
      <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">{posts.map((post) => (
        <article class="group" data-category={categoryOf(post)}>
          <a class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent" href={href(`/blog/${post.id}/`)}>
            <div class="aspect-[3/2] overflow-hidden bg-ui-fill">
              {post.data.coverImage
                ? <Image class="h-full w-full object-cover" src={post.data.coverImage} alt={post.data.coverAlt!} widths={[400, 800]} sizes="(min-width: 1024px) 24rem, 50vw" />
                : <div class="h-full w-full bg-[repeating-radial-gradient(circle_at_30%_60%,transparent_0_14px,var(--color-brand-accent)_14px_15px)] opacity-30" aria-hidden="true"></div>}
            </div>
            <div class="mt-5 flex items-baseline justify-between text-xs font-medium uppercase tracking-wide text-brand-muted">
              <span>{categoryOf(post)}</span>
              <time datetime={post.data.pubDate}>{formatDate(post.data.pubDate)}</time>
            </div>
            <h2 class="mt-4 text-xl font-medium tracking-tight text-balance transition-colors group-hover:text-brand-accent">{post.data.title}</h2>
            <p class="mt-3 leading-relaxed text-brand-muted">{post.data.description}</p>
          </a>
        </article>
      ))}</div>
    )}
  </section>
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const cards = document.querySelectorAll<HTMLElement>("[data-category]");
    buttons.forEach((button) => button.addEventListener("click", () => {
      buttons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
      cards.forEach((card) => { card.hidden = button.dataset.filter !== "all" && card.dataset.category !== button.dataset.filter; });
    }));
  </script>
</Base>
