---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import BlogCard from "../../components/BlogCard.astro";
import BlogFilters from "../../components/BlogFilters.astro";
import Divider from "../../components/landing/Divider.astro";
import PageHeader from "../../components/landing/PageHeader.astro";
import Rails from "../../components/landing/Rails.astro";
import Serif from "../../components/landing/Serif.astro";
import { categoriesOf, sortPosts } from "../../lib/blog";
const posts = sortPosts(await getCollection("blog"));
---
<Base title="Orso Blog" description="Product notes, guides, and news about editing Astro sites with Orso — from Markdown content to bigger site changes." image="/og-blog.png">
  <Rails>
    <PageHeader tag="Blog" lead="Product notes, guides and news about editing Astro sites with Orso — from a Markdown tweak to a whole new page.">
      Notes from the <Serif>studio</Serif>.
    </PageHeader>
    <Divider />
    <BlogFilters categories={categoriesOf(posts)} />
    <Divider />
    <section class="px-6 py-14 sm:px-10">
      {posts.length === 0 ? <p class="text-muted-ink">No blog posts yet. Check back soon for news and stories.</p> : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{posts.map((post) => <BlogCard post={post} />)}</div>
      )}
    </section>
    <Divider />
  </Rails>
</Base>
