---
import { getCollection } from "astro:content";
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Empty, EmptyDescription, EmptyHeader, EmptyTitle } from "@/components/ui/empty";
import Base from "@/layouts/Base.astro";
import { href } from "@/lib/href";
const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate) || a.id.localeCompare(b.id));
---
<Base title="Blog" description="News and stories from our team.">
  <section class="mx-auto max-w-5xl px-8 py-12">
    <h1 class="mb-8 text-h2">Blog</h1>
    {posts.length === 0 ? (
      <Empty>
        <EmptyHeader>
          <EmptyTitle>No blog posts yet</EmptyTitle>
          <EmptyDescription>Check back soon for news and stories.</EmptyDescription>
        </EmptyHeader>
      </Empty>
    ) : (
      <div class="grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-md">
        {posts.map((post) => (
          <Card size="sm">
            <CardHeader>
              <CardTitle>
                <h2><a class="hover:underline" href={href(`/blog/${post.id}/`)}>{post.data.title}</a></h2>
              </CardTitle>
              <time class="text-label text-tertiary" datetime={post.data.pubDate}>{post.data.pubDate}</time>
              <CardDescription>{post.data.description}</CardDescription>
            </CardHeader>
          </Card>
        ))}
      </div>
    )}
  </section>
</Base>
