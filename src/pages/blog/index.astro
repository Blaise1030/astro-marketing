---
import { getCollection } from "astro:content";
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Empty, EmptyDescription, EmptyHeader, EmptyTitle } from "@/components/ui/empty";
import Base from "@/layouts/Base.astro";
import { href } from "@/lib/href";
const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate) || a.id.localeCompare(b.id));
---
<Base title="Blog" description="News and stories from our team.">
  <section class="shell py-20 sm:py-section">
    <h1 class="text-h2">Blog</h1>
    <p class="mt-4 max-w-lg text-body text-muted-ink">Notes on the studio, the stack and the things we ship with it.</p>

    {posts.length === 0 ? (
      <Empty>
        <EmptyHeader>
          <EmptyTitle>No blog posts yet</EmptyTitle>
          <EmptyDescription>Check back soon for news and stories.</EmptyDescription>
        </EmptyHeader>
      </Empty>
    ) : (
      <div class="mt-12 grid grid-cols-[repeat(auto-fit,minmax(16rem,1fr))] gap-7">
        {posts.map((post) => (
          <Card size="sm" className="transition-colors hover:ring-hairline-strong">
            <CardHeader>
              <time class="text-eyebrow uppercase text-faint" datetime={post.data.pubDate}>{post.data.pubDate}</time>
              <CardTitle>
                <h2 class="text-h3"><a class="transition-colors hover:text-muted-ink" href={href(`/blog/${post.id}/`)}>{post.data.title}</a></h2>
              </CardTitle>
              <CardDescription className="text-body">{post.data.description}</CardDescription>
            </CardHeader>
          </Card>
        ))}
      </div>
    )}
  </section>
</Base>
