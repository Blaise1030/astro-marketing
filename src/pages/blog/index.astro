---
import Base from "../../layouts/Base.astro";
import BlogList from "../../components/BlogList.astro";
import { loadBlog } from "../../lib/categories";
const { categories, posts } = await loadBlog();
---
<Base title="Blog" description="News and stories from our team.">
  <section class="mx-auto max-w-5xl px-8 py-12">
    <h1 class="mb-8 text-4xl font-semibold tracking-tight">Blog</h1>
    <BlogList posts={posts} categories={categories} />
  </section>
</Base>
