---
import { getCollection, getEntries, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import BlogCard from "../../components/BlogCard.astro";
import { href } from "../../lib/href";
import { categoryOf, formatDate, slugify, sortPosts } from "../../lib/blog";
import { blogPostingJsonLd, canonicalUrl } from "../../lib/seo";
import Divider from "../../components/landing/Divider.astro";
import PageHeader from "../../components/landing/PageHeader.astro";
import Rails from "../../components/landing/Rails.astro";
import SectionIntro from "../../components/landing/SectionIntro.astro";
import Accent from "../../components/landing/Accent.astro";
import { proseClass } from "../../lib/prose";
export async function getStaticPaths() {
  const posts = sortPosts(await getCollection("blog"));
  return posts.map((entry, index) => {
    const related = entry.data.relatedPosts.map((id) => posts.find((post) => post.id === id)).filter((post) => post !== undefined);
    const more = [...related, ...posts.filter((post) => post.id !== entry.id && !related.includes(post))].slice(0, 3);
    return { params: { slug: entry.id }, props: { entry, newer: posts[index - 1], older: posts[index + 1], more } };
  });
}
const { entry, newer, older, more } = Astro.props;
const { Content } = await render(entry);
const categories = (await getEntries(entry.data.categories.map((id) => ({ collection: "blogCategories" as const, id }))))
  .filter((category): category is NonNullable<typeof category> => category != null)
  .map((category) => category.data.title);
const pageUrl = canonicalUrl(Astro.url);
const shareUrl = encodeURIComponent(pageUrl);
const shareTitle = encodeURIComponent(entry.data.title);
const linkClass = "transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand";
const navCard = "frame group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand";
const jsonLd = blogPostingJsonLd({
  title: entry.data.title,
  description: entry.data.description,
  url: pageUrl,
  datePublished: entry.data.pubDate,
});
---
<Base title={entry.data.title} description={entry.data.description} type="article" image="/og-blog.png" jsonLd={jsonLd}>
  <Rails>
    <article>
      <PageHeader tag={categoryOf(entry)} back={{ href: "/blog/", label: "Back to blog" }} lead={entry.data.description}>
        <Fragment slot="meta">
          <time class="font-mono text-[12px] text-faint" datetime={entry.data.pubDate}>{formatDate(entry.data.pubDate)}</time>
          {categories.length > 0 && <span class="font-mono text-[12px] text-faint">· {categories.join(", ").toLowerCase()}</span>}
          <a class={`font-mono text-[12px] text-faint ${linkClass}`} href={href(`/blog/category/${slugify(categoryOf(entry))}/`)}>· more {categoryOf(entry).toLowerCase()} →</a>
        </Fragment>
        {entry.data.title}
      </PageHeader>

      <div class="px-6 pb-14 sm:px-10">
        <div class="frame">
          <div class="frame-inner aspect-[2.2/1]">
            {entry.data.coverImage
              ? <Image class="h-full w-full object-cover" src={entry.data.coverImage} alt={entry.data.coverAlt!} widths={[800, 1200, 1600]} sizes="(min-width: 1152px) 70rem, 100vw" loading="eager" />
              : (
                <div class="dot-well grid h-full w-full place-items-center" aria-hidden="true">
                  <div class="float-card w-[min(80%,26rem)] rounded-xl p-4">
                    <p class="font-mono text-[11px] text-faint">src/content/blog/en/{entry.id}.md</p>
                    <p class="mt-2 text-[18px] font-medium leading-snug tracking-[-0.02em]">{entry.data.title}</p>
                    <div class="mt-3 h-1.5 w-full rounded-full bg-ink/[0.06]"></div>
                    <div class="mt-1.5 h-1.5 w-3/4 rounded-full bg-ink/[0.06]"></div>
                  </div>
                </div>
              )}
          </div>
        </div>
      </div>

      <Divider />

      <div class="grid gap-10 px-6 py-14 sm:px-10 lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-16">
        <aside class="flex flex-col gap-3 lg:sticky lg:top-24 lg:self-start">
          <p class="font-mono text-[11.5px] text-faint">share</p>
          <div class="flex gap-2">
            <a class="btn-quiet rounded-[8px] px-2.5 py-1 text-[12.5px] font-medium" href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`} rel="noopener">X</a>
            <a class="btn-quiet rounded-[8px] px-2.5 py-1 text-[12.5px] font-medium" href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} rel="noopener">LinkedIn</a>
          </div>
        </aside>
        <div class="min-w-0">
          <div class={`${proseClass} max-w-2xl`}><Content /></div>
          {(newer || older) && (
            <nav class="mt-16 grid max-w-2xl gap-4 sm:grid-cols-2" aria-label="More posts">
              <div>{newer && <a class={navCard} href={href(`/blog/${newer.id}/`)}><span class="frame-inner block p-4"><span class="block font-mono text-[11.5px] text-faint">← newer</span><span class="mt-1.5 block text-[15px] font-medium tracking-[-0.015em] transition-colors group-hover:text-brand-ink">{newer.data.title}</span></span></a>}</div>
              <div class="sm:text-right">{older && <a class={navCard} href={href(`/blog/${older.id}/`)}><span class="frame-inner block p-4"><span class="block font-mono text-[11.5px] text-faint">older →</span><span class="mt-1.5 block text-[15px] font-medium tracking-[-0.015em] transition-colors group-hover:text-brand-ink">{older.data.title}</span></span></a>}</div>
            </nav>
          )}
        </div>
      </div>
    </article>

    {more.length > 0 && (
      <>
        <Divider />
        <section class="flex flex-col gap-12 px-6 py-20 sm:px-10" aria-labelledby="keep-reading">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <SectionIntro tag="Keep reading"><span id="keep-reading">More from <Accent>Orso</Accent>.</span></SectionIntro>
            <a class={`font-mono text-[12px] text-faint ${linkClass}`} href={href("/blog/")}>view all posts →</a>
          </div>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{more.map((post) => <BlogCard post={post} />)}</div>
        </section>
      </>
    )}
    <Divider />
  </Rails>
</Base>
