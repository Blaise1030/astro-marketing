---
import { getCollection, render } from "astro:content";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import Base from "@/layouts/Base.astro";
import { href } from "@/lib/href";
import { Image } from "astro:assets";
export async function getStaticPaths() {
  return (await getCollection("blog")).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <article class="mx-auto max-w-5xl px-8 py-12">
    <a class={buttonVariants({ variant: "link" })} href={href("/blog/")}>Back to Blog</a>
    <h1 class="mt-4 text-h2">{entry.data.title}</h1>
    <p class="mt-2 text-lg text-muted-foreground">{entry.data.description}</p>
    <time class="mt-2 block text-label text-muted-foreground" datetime={entry.data.pubDate}>{entry.data.pubDate}</time>
    {entry.data.coverImage && <Image class="mt-6 h-auto max-w-full rounded-xl" src={entry.data.coverImage} alt={entry.data.coverAlt!} />}
    {entry.data.tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {entry.data.tags.map((tag) => <Badge variant="outline">{tag}</Badge>)}
      </div>
    )}
    <div class="prose mt-8 max-w-3xl dark:prose-invert prose-img:h-auto prose-img:max-w-full"><Content /></div>
  </article>
</Base>
