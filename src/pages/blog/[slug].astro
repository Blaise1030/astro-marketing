---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/href";
import { Image } from "astro:assets";
export async function getStaticPaths() {
  return (await getCollection("blog")).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <article class="mx-auto max-w-6xl px-6 py-section sm:px-8 sm:py-section-wide">
    <a class="text-sm text-brand-accent hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent" href={href("/blog/")}>Back to Blog</a>
    <h1 class="mt-8 max-w-4xl font-editorial text-4xl leading-tight tracking-tight text-balance sm:text-6xl">{entry.data.title}</h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-brand-muted">{entry.data.description}</p>
    <time class="mt-2 block text-sm text-brand-muted" datetime={entry.data.pubDate}>{entry.data.pubDate}</time>
    {entry.data.coverImage && <Image class="mt-6 h-auto max-w-full rounded-xl" src={entry.data.coverImage} alt={entry.data.coverAlt!} />}
    {entry.data.tags.length > 0 && <p class="mt-4 text-sm text-brand-muted">{entry.data.tags.join(", ")}</p>}
    <div class="prose prose-invert mt-10 max-w-3xl break-words dark:prose-invert prose-headings:font-medium prose-headings:tracking-tight prose-a:text-brand-accent prose-a:decoration-brand-accent/40 prose-a:underline-offset-4 prose-pre:border prose-pre:border-section-line prose-pre:bg-section-panel prose-img:h-auto prose-img:max-w-full"><Content /></div>
  </article>
</Base>
