---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import BlogCard from "../../components/BlogCard.astro";
import { href } from "../../lib/href";
import { categoryOf, formatDate, slugify, sortPosts } from "../../lib/blog";
export async function getStaticPaths() {
  const posts = sortPosts(await getCollection("blog"));
  return posts.map((entry, index) => {
    const related = entry.data.relatedPosts.map((id) => posts.find((post) => post.id === id)).filter((post) => post !== undefined);
    const more = [...related, ...posts.filter((post) => post.id !== entry.id && !related.includes(post))].slice(0, 3);
    return { params: { slug: entry.id }, props: { entry, newer: posts[index - 1], older: posts[index + 1], more } };
  });
}
const { entry, newer, older, more } = Astro.props;
const { Content } = await render(entry);
const shareUrl = encodeURIComponent(Astro.url.href);
const shareTitle = encodeURIComponent(entry.data.title);
const linkClass = "transition-colors hover:text-brand-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent";
---
<Base title={entry.data.title} description={entry.data.description}>
  <article class="mx-auto max-w-6xl px-6 pt-8 pb-section sm:px-8 sm:py-section-wide">
    <a class={`text-xs text-brand-muted ${linkClass}`} href={href("/blog/")}>← All posts</a>
    <div class="mt-8 flex gap-4 text-xs font-medium text-brand-muted">
      <a class={linkClass} href={href(`/blog/category/${slugify(categoryOf(entry))}/`)}>{categoryOf(entry)}</a>
      <time datetime={entry.data.pubDate}>{formatDate(entry.data.pubDate)}</time>
    </div>
    <h1 class="mt-4 max-w-3xl font-medium text-4xl leading-tight tracking-tight text-balance sm:text-5xl">{entry.data.title}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-brand-muted">{entry.data.description}</p>
    <div class="mt-10 aspect-[2.2/1] overflow-hidden bg-ui-fill">
      {entry.data.coverImage
        ? <Image class="h-full w-full object-cover" src={entry.data.coverImage} alt={entry.data.coverAlt!} widths={[800, 1200, 1600]} sizes="(min-width: 1152px) 72rem, 100vw" loading="eager" />
        : <div class="h-full w-full bg-[repeating-radial-gradient(circle_at_30%_60%,transparent_0_14px,var(--color-brand-accent)_14px_15px)] opacity-30" aria-hidden="true"></div>}
    </div>
    <div class="mt-12 grid gap-10 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
      <aside class="text-xs text-brand-muted">
        <p class="font-medium">Share this post</p>
        <div class="mt-3 flex gap-4">
          <a class={linkClass} href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`} rel="noopener">X</a>
          <a class={linkClass} href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} rel="noopener">LinkedIn</a>
        </div>
      </aside>
      <div>
        <div class="prose max-w-2xl break-words dark:prose-invert prose-headings:font-medium prose-headings:tracking-tight prose-a:text-brand-accent prose-a:decoration-brand-accent/40 prose-a:underline-offset-4 prose-pre:border prose-pre:border-section-line prose-pre:bg-section-panel prose-pre:text-brand-foreground prose-img:h-auto prose-img:max-w-full"><Content /></div>
        {(newer || older) && (
          <nav class="mt-16 grid max-w-2xl grid-cols-2 gap-8 border-t border-section-line pt-6 text-sm" aria-label="More posts">
            <div>{newer && <a class={`block ${linkClass}`} href={href(`/blog/${newer.id}/`)}><span class="block text-xs text-brand-muted">← Newer post</span><span class="mt-2 block font-medium">{newer.data.title}</span></a>}</div>
            <div class="text-right">{older && <a class={`block ${linkClass}`} href={href(`/blog/${older.id}/`)}><span class="block text-xs text-brand-muted">Older post →</span><span class="mt-2 block font-medium">{older.data.title}</span></a>}</div>
          </nav>
        )}
      </div>
    </div>
  </article>
  {more.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 pb-section sm:px-8 sm:pb-section-wide" aria-labelledby="keep-reading">
      <p class="text-xs font-medium text-brand-muted">/// Keep reading</p>
      <div class="mt-4 mb-10 flex items-baseline justify-between">
        <h2 id="keep-reading" class="text-3xl font-medium tracking-tight">More from Orso</h2>
        <a class={`text-sm text-brand-muted ${linkClass}`} href={href("/blog/")}>View all posts →</a>
      </div>
      <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">{more.map((post) => <BlogCard post={post} />)}</div>
    </section>
  )}
</Base>
