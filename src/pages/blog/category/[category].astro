---
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import BlogList from "../../../components/BlogList.astro";
import { loadBlog } from "../../../lib/categories";
export async function getStaticPaths() {
  const { categories, posts } = await loadBlog();
  return categories.map((category) => ({
    params: { category: category.id },
    props: { category, categories, posts: posts.filter((item) => item.category?.id === category.id) },
  }));
}
const { category, categories, posts } = Astro.props;
const { Content } = await render(category);
---
<Base title={`${category.data.title} · Blog`} description={category.data.description ?? `Blog posts about ${category.data.title}.`}>
  <section class="mx-auto max-w-5xl px-8 py-12">
    <h1 class="text-4xl font-semibold tracking-tight">{category.data.title}</h1>
    {category.data.description && <p class="mt-2 text-lg text-secondary dark:text-neutral-400">{category.data.description}</p>}
    {category.body?.trim() && <div class="prose mt-4 max-w-3xl dark:prose-invert prose-a:text-accent"><Content /></div>}
    <div class="mt-8"><BlogList posts={posts} categories={categories} active={category.id} /></div>
  </section>
</Base>
