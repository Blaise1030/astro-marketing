---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import BlogCard from "../../../components/BlogCard.astro";
import BlogFilters from "../../../components/BlogFilters.astro";
import Divider from "../../../components/landing/Divider.astro";
import PageHeader from "../../../components/landing/PageHeader.astro";
import Rails from "../../../components/landing/Rails.astro";
import Accent from "../../../components/landing/Accent.astro";
import { categoriesOf, categoryOf, slugify, sortPosts } from "../../../lib/blog";
export async function getStaticPaths() {
  const posts = sortPosts(await getCollection("blog"));
  const categories = categoriesOf(posts);
  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: { category, categories, posts: posts.filter((post) => categoryOf(post) === category) },
  }));
}
const { category, categories, posts } = Astro.props;
---
<Base title={`${category} · Project Orso Blog`} description={`Orso blog posts about ${category}.`} image="/og-blog.png">
  <Rails>
    <PageHeader tag="Blog" back={{ href: "/blog/", label: "All posts" }}>
      <span class="capitalize">{category}</span> <Accent>notes</Accent>.
    </PageHeader>
    <Divider />
    <BlogFilters categories={categories} active={category} />
    <section class="px-6 py-14 sm:px-10">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{posts.map((post) => <BlogCard post={post} />)}</div>
    </section>
    <Divider />
  </Rails>
</Base>
