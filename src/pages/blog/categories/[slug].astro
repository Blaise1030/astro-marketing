---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { href } from "../../../lib/href";

export async function getStaticPaths() {
  return (await getCollection("blogCategories")).map((category) => ({
    params: { slug: category.data.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = (await getCollection("blog"))
  .filter((post) => post.data.categories.includes(category.id))
  .sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate) || a.id.localeCompare(b.id));
---
<Base title={category.data.title} description={category.data.description ?? `Posts in ${category.data.title}.`}>
  <section class="mx-auto max-w-5xl px-8 py-12">
    <a class="text-sm hover:underline" href={href("/blog/categories/")}>Back to categories</a>
    <h1 class="mt-4 mb-2 text-4xl font-bold tracking-tight">{category.data.title}</h1>
    {category.data.description && <p class="mb-8 text-lg text-neutral-600 dark:text-neutral-400">{category.data.description}</p>}
    {posts.length === 0 ? <p class="mt-8">No posts in this category yet.</p> : (
      <div class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-6">{posts.map((post) => (
        <article class="rounded-xl border border-neutral-400/30 p-5">
          <h2 class="text-lg font-semibold"><a class="hover:underline" href={href(`/blog/${post.id}/`)}>{post.data.title}</a></h2>
          <time class="mt-1 block text-sm text-neutral-500" datetime={post.data.pubDate}>{post.data.pubDate}</time>
          <p class="mt-3">{post.data.description}</p>
        </article>
      ))}</div>
    )}
  </section>
</Base>
