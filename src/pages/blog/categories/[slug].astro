---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import BlogCard from "../../../components/BlogCard.astro";
import Divider from "../../../components/landing/Divider.astro";
import PageHeader from "../../../components/landing/PageHeader.astro";
import Rails from "../../../components/landing/Rails.astro";
import { sortPosts } from "../../../lib/blog";

export async function getStaticPaths() {
  return (await getCollection("blogCategories")).map((category) => ({
    params: { slug: category.data.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = sortPosts(
  (await getCollection("blog")).filter((post) => post.data.categories.includes(category.id)),
);
---
<Base title={category.data.title} description={category.data.description ?? `Posts in ${category.data.title}.`} image="/og-blog.png">
  <Rails>
    <PageHeader tag="Blog category" back={{ href: "/blog/categories/", label: "All categories" }} lead={category.data.description}>
      {category.data.title}
    </PageHeader>
    <Divider />
    <section class="px-6 py-14 sm:px-10">
      {posts.length === 0 ? <p class="text-muted-ink">No posts in this category yet.</p> : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{posts.map((post) => <BlogCard post={post} />)}</div>
      )}
    </section>
    <Divider />
  </Rails>
</Base>
