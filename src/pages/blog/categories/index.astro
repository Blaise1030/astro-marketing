---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Divider from "../../../components/landing/Divider.astro";
import PageHeader from "../../../components/landing/PageHeader.astro";
import Rails from "../../../components/landing/Rails.astro";
import Accent from "../../../components/landing/Accent.astro";
import TopicCard from "../../../components/landing/TopicCard.astro";

const categories = (await getCollection("blogCategories")).sort(
  (a, b) => a.data.title.localeCompare(b.data.title) || a.data.slug.localeCompare(b.data.slug),
);
const posts = await getCollection("blog");
const postsIn = (id: string) => posts.filter((post) => post.data.categories.includes(id));
---
<Base title="Blog categories" description="Browse Orso blog posts by topic — product updates, guides, company notes, and more." image="/og-blog.png">
  <Rails>
    <PageHeader tag="Blog" back={{ href: "/blog/", label: "Back to blog" }}>
      Browse by <Accent>topic</Accent>.
    </PageHeader>
    <Divider />
    <section class="px-6 py-14 sm:px-10">
      {categories.length === 0 ? <p class="text-muted-ink">No blog categories yet.</p> : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {categories.map((category) => {
            const list = postsIn(category.id);
            return (
              <TopicCard
                href={`/blog/categories/${category.data.slug}/`}
                title={category.data.title}
                description={category.data.description}
                meta={`${list.length} ${list.length === 1 ? "post" : "posts"}`}
                items={list.map((post) => post.data.title)}
              />
            );
          })}
        </div>
      )}
    </section>
    <Divider />
  </Rails>
</Base>
